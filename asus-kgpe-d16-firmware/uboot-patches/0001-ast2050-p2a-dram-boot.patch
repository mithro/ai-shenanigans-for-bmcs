     ldr r0, =SDRAM_CONFIG_REG               @ MCR04 - Config register
 #ifdef CONFIG_1G_DDRII
-    ldr r1, =0x00000d89
+    ldr r1, =0x00000585		@ was 0x00000d89; KGPE-D16 DDR2 = 4-BANK, 64MB
