diff --git a/board/aspeed/ast2050/flash_spi.c b/board/aspeed/ast2050/flash_spi.c
index 8eda064..ae438a1 100644
--- a/board/aspeed/ast2050/flash_spi.c
+++ b/board/aspeed/ast2050/flash_spi.c
@@ -427,7 +427,17 @@ static ulong flash_get_size (ulong base, int banknum)
 
 	default:
 	    printf("Can't support this SPI Flash!! \n");
-	    break;
+	    /* No flash chip reachable (e.g. P2A DRAM boot, flash not served over
+	     * P2A). Return a benign single-sector geometry IMMEDIATELY: the rest of
+	     * this function (sector loop with an otherwise-uninitialised count, then
+	     * the SPI-controller clock config that runs on uninitialised WriteClk/
+	     * EraseClk/ReadClk and touches flash hardware) hangs with no chip.
+	     * flash_init()>0 keeps U-Boot's generic wrapper happy -> reaches prompt. */
+	    info->sector_count = 1;
+	    info->size = 0x10000;
+	    info->start[0] = base;
+	    info->protect[0] = 0;
+	    return info->size;
 	}
 			
 	debug ("erase_region_size = %d\n",
