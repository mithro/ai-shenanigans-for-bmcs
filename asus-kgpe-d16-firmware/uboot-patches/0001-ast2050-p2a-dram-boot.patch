diff --git a/include/configs/asus.h b/include/configs/asus.h
index 4d1320b..56962ef 100644
--- a/include/configs/asus.h
+++ b/include/configs/asus.h
@@ -237,7 +237,7 @@
 #define CONFIG_SYS_NS16550_COM2		0x1e784000
 #define	CONFIG_SYS_LOADS_BAUD_CHANGE
 #define CONFIG_CONS_INDEX		2
-#define CONFIG_BAUDRATE			38400
+#define CONFIG_BAUDRATE			1200
 #define CONFIG_SYS_BAUDRATE_TABLE	{ 9600, 19200, 38400, 57600, 115200 }
 #define CONFIG_ASPEED_COM CONFIG_SYS_NS16550_COM2
 #define CONFIG_ASPEED_COM_IER (CONFIG_ASPEED_COM + 0x4)
@@ -346,9 +346,23 @@
 #define CFG_CMD_SLT		(CFG_CMD_VIDEOTEST | CFG_CMD_MACTEST | CFG_CMD_HACTEST | CFG_CMD_MICTEST)
 */
 
-#define CONFIG_SYS_INIT_SP_ADDR	(CONFIG_SYS_SDRAM_BASE + 0x1000 - GENERATED_GBL_DATA_SIZE)
+/* Init stack at 16MB into DRAM so it clears the U-Boot image loaded at
+ * SDRAM_BASE (P2A DRAM boot); the stock +0x1000 collides with our own code. */
+#define CONFIG_SYS_INIT_SP_ADDR	(CONFIG_SYS_SDRAM_BASE + 0x1000000 - GENERATED_GBL_DATA_SIZE)
 
 #define CONFIG_ASPEED_ENABLE_WATCHDOG
 #define CONFIG_ASPEED_WATCHDOG_TIMEOUT (5*60) // 5m
 
+/* --- P2A DRAM boot overrides (no usable SPI flash over P2A) --- */
+/* The boot flash is not served over P2A on the dead-firmware rig, so reading the
+ * environment from flash data-aborts after the "Can't support this SPI Flash"
+ * message. Use the compiled-in default environment instead -> reaches an
+ * interactive prompt. */
+#undef  CONFIG_ENV_IS_IN_FLASH
+#undef  CONFIG_ENV_OFFSET
+#undef  CONFIG_ASPEED_WRITE_DEFAULT_ENV
+#define CONFIG_ENV_IS_NOWHERE   1
+#undef  CONFIG_ENV_SIZE
+#define CONFIG_ENV_SIZE         0x2000
+
 #endif	/* __CONFIG_H */
