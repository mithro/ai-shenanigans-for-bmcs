diff --git a/drivers/i2c/ast_i2c.c b/drivers/i2c/ast_i2c.c
index 13420ade..1ba31c3b 100644
--- a/drivers/i2c/ast_i2c.c
+++ b/drivers/i2c/ast_i2c.c
@@ -105,18 +105,46 @@ static int ast_i2c_ofdata_to_platdata(struct udevice *dev)
 
 static int ast_i2c_probe(struct udevice *dev)
 {
-//	struct ast2500_scu *scu;
+	struct ast_i2c_priv *priv = dev_get_priv(dev);
+	u32 rst, chan;
 
 	debug("Enabling I2C%u\n", dev->seq);
 
 	/*
-	 * Get all I2C devices out of Reset.
-	 * Only needs to be done once, but doing it for every
-	 * device does not hurt.
+	 * AST2050 (G3) gotcha 1 — the whole 7-engine I2C block powers up HELD IN
+	 * RESET (SCU04[2] = 1 at power-on on the AST2050 — datasheet default; the
+	 * custom kgpe-d16-bmc QEMU machine models it via aspeed_2050_i2c_rst()).
+	 * De-assert SCU04[2] before touching any bus (the Zephyr i2c_aspeed_g3
+	 * driver and the vendor AST2050 U-Boot i2c_init() both do this). SCU writes
+	 * to protected registers require the write-unlock key (0x1688A8A8) in SCU00
+	 * first. Without this the engines stay inert and every device read NAKs -121
+	 * (device-driver-program #167). SCU base = 0x1E6E2000; SYS_RST_CTRL @ 0x04.
+	 * The stock evb-ast2400 driver stubbed this out (it assumed U-Boot's own
+	 * ast2500 SoC init had already released reset, which does not happen on G3).
+	 */
+	writel(0x1688a8a8, (void *)0x1e6e2000);		/* unlock the SCU */
+	rst = readl((void *)0x1e6e2004);		/* SYS_RST_CTRL (SCU04) */
+	writel(rst & ~(1U << 2), (void *)0x1e6e2004);	/* clear I2C reset SCU04[2] */
+
+	/*
+	 * AST2050 (G3) gotcha 2 — the muxed I2C channels 5/6/7 (datasheet numbering;
+	 * engine 4/5/6, register-block base 0x1E78A140/180/1C0) need their SCU74
+	 * Multi-Function-Pin bit set (SDA5/6/7 = SCU74[12/13/14]) or the pads are not
+	 * routed to the I2C engine. Channels 1-4 have dedicated pads and need nothing.
+	 * The vendor AST2050 U-Boot i2c_init() does `SCU74 |= 0x5000` (bits 12+14) and
+	 * the silicon-proven Zephyr i2c_aspeed_g3 driver sets the per-channel bit;
+	 * WITHOUT this the FRU EEPROM on I2C5 (0x54) NAKs/times out on real silicon —
+	 * QEMU passes regardless because it does not gate channel 5 on the pin-mux
+	 * (review CONFIRMED-1; same root cause as the Zephyr #156 engine-4 timeout).
+	 * chan = (bus register base - 0x1E78A000) / 0x40  (so engine1=chan2=I2C2 ...).
 	 */
+	chan = ((uintptr_t)priv->regs - 0x1e78a000) / 0x40;
+	if (chan >= 5 && chan <= 7) {
+		u32 mfp = readl((void *)0x1e6e2074);	/* SCU74 (SCU already unlocked above) */
+
+		writel(mfp | (1U << (12 + (chan - 5))), (void *)0x1e6e2074);
+	}
 
-	//TODO scu reset and get clk
-	
 	ast_i2c_init_bus(dev);
 
 	return 0;
