				};
			};

			hwrng@1e6e2078 {
				compatible = "timeriomem_rng";
				reg = <0x1e6e2078 0x04>;
				period = <0x01>;
				quality = <0x64>;
			};

			adc@1e6e9000 {
				compatible = "aspeed,ast2400-adc";
				reg = <0x1e6e9000 0xb0>;
				clocks = <0x02 0x1a>;
				resets = <0x02 0x02>;
				#io-channel-cells = <0x01>;
				status = "disabled";
			};

			sram@1e720000 {
				compatible = "mmio-sram";
				reg = <0x1e720000 0x8000>;
			};

			/*
			 * AST2050 video/capture engine (KVM screen capture, F8). Enabled
			 * so the aspeed-video V4L2 driver binds and exposes /dev/video0 to
			 * capture the AST2050 VGA framebuffer (the host's BIOS/boot screen;
			 * the OS runs on a discrete GPU so the AST2050 fb retains the BIOS
			 * content). Was "disabled" here (matching the QEMU DTS's &video okay).
			 */
			video@1e700000 {
				compatible = "aspeed,ast2050-video-engine";
				reg = <0x1e700000 0x1000>;
				clocks = <0x02 0x03 0x02 0x00>;
				clock-names = "vclk", "eclk";
				interrupts = <0x07>;
				status = "okay";
			};

			sd-controller@1e740000 {
				compatible = "aspeed,ast2400-sd-controller";
				reg = <0x1e740000 0x100>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x1e740000 0x10000>;
				clocks = <0x02 0x16>;
				status = "disabled";

				sdhci@100 {
					compatible = "aspeed,ast2400-sdhci";
					reg = <0x100 0x100>;
					interrupts = <0x1a>;
					sdhci,auto-cmd12;
					clocks = <0x02 0x1c>;
					status = "disabled";
				};

				sdhci@200 {
					compatible = "aspeed,ast2400-sdhci";
					reg = <0x200 0x100>;
					interrupts = <0x1a>;
					sdhci,auto-cmd12;
					clocks = <0x02 0x1c>;
					status = "disabled";
				};
			};

			bmcgpio: gpio@1e780000 {
				#gpio-cells = <0x02>;
				gpio-controller;
				compatible = "aspeed,ast2400-gpio";
				reg = <0x1e780000 0x1000>;
				interrupts = <0x14>;
				gpio-ranges = <0x05 0x00 0x00 0xdc>;
				clocks = <0x02 0x1a>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			timer@1e782000 {
				compatible = "aspeed,ast2400-timer";
				reg = <0x1e782000 0x90>;
				interrupts = <0x10 0x11 0x12 0x23 0x24 0x25 0x26 0x27>;
				clocks = <0x02 0x1a>;
				clock-names = "PCLK";
			};

			rtc@1e781000 {
				/*
				 * The AST2050 (G3) RTC is COUNTER-style (datasheet §24), NOT the
				 * BCD ast2400-rtc — it needs the counter-style variant added in
				 * kernel patch 0009 (rtc-aspeed.c). RTC04 is field-packed and the
				 * alarm fires on the RTC's single IRQ = VIC source 22
				 * (silicon-proven, #192). Kept in sync with the QEMU board dts.
				 * NOTE: build-realhw-kernel.py actually ships the QEMU dts
				 * (aspeed-bmc-asus-kgpe-d16.dts) AS the realhw.dtb, so THIS file is
				 * a reference variant, not the built one; corrected here anyway so
				 * it does not mislead (it carried the wrong ast2400-rtc compatible).
				 */
				compatible = "aspeed,ast2050-rtc";
				reg = <0x1e781000 0x20>;
				interrupts = <22>;
				status = "okay";
			};

			serial@1e783000 {
				compatible = "ns16550a";
				reg = <0x1e783000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x09>;
				clocks = <0x02 0x0d>;
				resets = <0x06 0x04>;
				no-loopback-test;
				status = "disabled";
			};

			serial@1e784000 {
				compatible = "ns16550a";
				reg = <0x1e784000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x0a>;
				clocks = <0x02 0x0f>;
				no-loopback-test;
				status = "okay";
			};

			watchdog@1e785000 {
				compatible = "aspeed,ast2400-wdt";
				reg = <0x1e785000 0x1c>;
				clocks = <0x02 0x1a>;
				status = "okay";
			};

			watchdog@1e785020 {
				compatible = "aspeed,ast2400-wdt";
				reg = <0x1e785020 0x1c>;
				clocks = <0x02 0x1a>;
			};

			pwm-tacho-controller@1e786000 {
				compatible = "aspeed,ast2400-pwm-tacho";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x1e786000 0x1000>;
				clocks = <0x02 0x23>;
				resets = <0x02 0x05>;
				status = "disabled";
			};

			serial@1e787000 {
				compatible = "aspeed,ast2400-vuart";
				reg = <0x1e787000 0x40>;
				reg-shift = <0x02>;
				interrupts = <0x08>;
				clocks = <0x02 0x1a>;
				no-loopback-test;
				status = "okay";
			};

			lpc@1e789000 {
				compatible = "aspeed,ast2400-lpc-v2", "simple-mfd", "syscon";
				reg = <0x1e789000 0x1000>;
				reg-io-width = <0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x1e789000 0x1000>;

				lpc-ctrl@80 {
					compatible = "aspeed,ast2400-lpc-ctrl";
					reg = <0x80 0x10>;
					clocks = <0x02 0x08>;
					status = "disabled";
				};

				lpc-snoop@90 {
					compatible = "aspeed,ast2400-lpc-snoop";
					reg = <0x90 0x08>;
					interrupts = <0x08>;
					clocks = <0x02 0x08>;
					snoop-ports = <0x80>;
					status = "okay";
				};

				lhc@a0 {
					compatible = "aspeed,ast2400-lhc";
					reg = <0xa0 0x24 0xc8 0x08>;
				};

				reset-controller@98 {
					compatible = "aspeed,ast2400-lpc-reset";
					reg = <0x98 0x04>;
					#reset-cells = <0x01>;
					phandle = <0x06>;
				};

				ibt@140 {
					compatible = "aspeed,ast2400-ibt-bmc";
					reg = <0x140 0x18>;
					interrupts = <0x08>;
					clocks = <0x02 0x08>;
					status = "disabled";
				};

				uart-routing@9c {
					compatible = "aspeed,ast2400-uart-routing";
					reg = <0x9c 0x04>;
					status = "disabled";
				};
			};

			peci-controller@1e78b000 {
				compatible = "aspeed,ast2400-peci";
				reg = <0x1e78b000 0x60>;
				interrupts = <0x0f>;
				clocks = <0x02 0x06>;
				resets = <0x02 0x06>;
				cmd-timeout-ms = <0x3e8>;
				clock-frequency = <0xf4240>;
				status = "disabled";
			};

			serial@1e78d000 {
				compatible = "ns16550a";
				reg = <0x1e78d000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x20>;
				clocks = <0x02 0x0e>;
				resets = <0x06 0x05>;
				no-loopback-test;
				status = "disabled";
			};

			serial@1e78e000 {
				compatible = "ns16550a";
				reg = <0x1e78e000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x21>;
				clocks = <0x02 0x14>;
				resets = <0x06 0x06>;
				no-loopback-test;
				status = "disabled";
			};

			serial@1e78f000 {
				compatible = "ns16550a";
				reg = <0x1e78f000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x22>;
				clocks = <0x02 0x15>;
				resets = <0x06 0x07>;
				no-loopback-test;
				status = "disabled";
			};

			bus@1e78a000 {
				compatible = "simple-bus";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x1e78a000 0x1000>;

				interrupt-controller@0 {
					#interrupt-cells = <0x01>;
					compatible = "aspeed,ast2400-i2c-ic";
					reg = <0x00 0x40>;
					interrupts = <0x0c>;
					interrupt-controller;
					phandle = <0x07>;
				};

				i2c-bus@40 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x40 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x00>;
					interrupt-parent = <0x07>;
					status = "disabled";
				};

				i2c1bus: i2c-bus@80 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x80 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x01>;
					interrupt-parent = <0x07>;
					status = "disabled";
				};

				i2c-bus@c0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0xc0 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x02>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x08>;
					status = "disabled";
				};

				i2c-bus@100 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x100 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x03>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x09>;
					status = "okay";

					/* D09: AMD SB-TSI processor thermal (schematic §10.2,
					 * I2C4 = DT i2c3, 0x4c=P0 / 0x4d=P1, via QU4 FETs). Binds
					 * the sbtsi_temp hwmon driver -> real CPU die temps when
					 * the host is powered. */
					sbtsi@4c {
						compatible = "amd,sbtsi";
						reg = <0x4c>;
					};

					sbtsi@4d {
						compatible = "amd,sbtsi";
						reg = <0x4d>;
					};
				};

				i2c-bus@140 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x140 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x04>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x0a>;
					status = "disabled";
				};

				i2c-bus@180 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x180 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x05>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x0b>;
					status = "disabled";
				};

				i2c-bus@1c0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x1c0 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x06>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x0c>;
					status = "disabled";
				};

				i2c-bus@300 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x300 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x07>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x0d>;
					status = "disabled";
				};

				i2c-bus@340 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x340 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x08>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x0e>;
					status = "disabled";
				};

				i2c-bus@380 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x380 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x09>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x0f>;
					status = "disabled";
				};

				i2c-bus@3c0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x3c0 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x0a>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x10>;
					status = "disabled";
				};

				i2c-bus@400 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x400 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x0b>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x11>;
					status = "disabled";
				};

				i2c-bus@440 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x440 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x0c>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x12>;
					status = "disabled";
				};

				i2c-bus@480 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x480 0x40>;
					compatible = "aspeed,ast2400-i2c-bus";
					clocks = <0x02 0x1a>;
					resets = <0x02 0x07>;
					bus-frequency = <0x186a0>;
					interrupts = <0x0d>;
					interrupt-parent = <0x07>;
					pinctrl-names = "default";
					pinctrl-0 = <0x13>;
					status = "disabled";
				};
			};
		};
	};

	chosen {
		stdout-path = "/ahb/apb/serial@1e784000";
		bootargs = "console=ttyS4,115200n8 earlyprintk";
	};
};
