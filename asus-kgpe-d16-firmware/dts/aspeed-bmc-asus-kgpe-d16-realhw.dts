					};

					uart6_default {
						function = "UART6";
						groups = "UART6";
					};

					usbcki_default {
						function = "USBCKI";
						groups = "USBCKI";
					};

					usb2h_default {
						function = "USB2H1";
						groups = "USB2H1";
						phandle = <0x03>;
					};

					usb2d_default {
						function = "USB2D1";
						groups = "USB2D1";
						phandle = <0x04>;
					};

					vgabios_rom_default {
						function = "VGABIOS_ROM";
						groups = "VGABIOS_ROM";
					};

