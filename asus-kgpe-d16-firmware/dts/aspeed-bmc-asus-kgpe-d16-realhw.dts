/dts-v1/;

/*
 * NOTE: This is a flattened, human-readable REFERENCE MIRROR of the real-HW
 * device tree. It is NOT the source the build compiles. build-realhw-kernel.py
 * copies qemu-firmware/dts/aspeed-bmc-asus-kgpe-d16.dts (the overlay-style tree
 * on aspeed-g4.dtsi) into the kernel and builds THAT for both QEMU and silicon.
 * Keep this mirror consistent with that source, but editing it alone changes
 * nothing about the shipped DTB. (Verified 2026-07-18: only docs reference this
 * file; no build/deploy script does.)
 */

/ {
	model = "ASUS KGPE-D16 BMC";
	compatible = "asus,kgpe-d16-bmc", "aspeed,ast2400";
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;

	aliases {
		i2c0 = "/ahb/apb/bus@1e78a000/i2c-bus@40";
		i2c1 = "/ahb/apb/bus@1e78a000/i2c-bus@80";
		i2c2 = "/ahb/apb/bus@1e78a000/i2c-bus@c0";
		i2c3 = "/ahb/apb/bus@1e78a000/i2c-bus@100";
		i2c4 = "/ahb/apb/bus@1e78a000/i2c-bus@140";
		i2c5 = "/ahb/apb/bus@1e78a000/i2c-bus@180";
		i2c6 = "/ahb/apb/bus@1e78a000/i2c-bus@1c0";
		i2c7 = "/ahb/apb/bus@1e78a000/i2c-bus@300";
		i2c8 = "/ahb/apb/bus@1e78a000/i2c-bus@340";
		i2c9 = "/ahb/apb/bus@1e78a000/i2c-bus@380";
		i2c10 = "/ahb/apb/bus@1e78a000/i2c-bus@3c0";
		i2c11 = "/ahb/apb/bus@1e78a000/i2c-bus@400";
		i2c12 = "/ahb/apb/bus@1e78a000/i2c-bus@440";
		i2c13 = "/ahb/apb/bus@1e78a000/i2c-bus@480";
		serial0 = "/ahb/apb/serial@1e783000";
		serial1 = "/ahb/apb/serial@1e78d000";
		serial2 = "/ahb/apb/serial@1e78e000";
		serial3 = "/ahb/apb/serial@1e78f000";
		serial4 = "/ahb/apb/serial@1e784000";
		serial5 = "/ahb/apb/serial@1e787000";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,arm926ej-s";
			device_type = "cpu";
			reg = <0x00>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x4000000>;
	};

	/*
	 * QU9/QU5/U23 I2C mux fabric behind I2C2 (Linux i2c-1): DIMM SPD/TSOD
	 * buses + aux-panel segment, channel-selected by GPIOF4/F5 (AST_I2CS0/1,
	 * balls W4/W3; Linux GPIO lines 44/45). No enable GPIO exists: QU9
	 * bridges only while host SYS_PWRGD is high, and U23 hands the selects
	 * to the BMC only after the host BIOS asserts SB_BIOS_POST_COMPLT#
	 * (hardware mutex) — host off => no ACK; mid-POST => SP5100 owns
	 * routing. See schematic-wiring/I2C-MUX-FABRIC-ARBITRATION.md.
	 */
	i2cmux {
		compatible = "i2c-mux-gpio";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		i2c-parent = <&i2c1bus>;
		/* order: bit0 = S0 (GPIOF4 = line 44), bit1 = S1 (GPIOF5 = 45) */
		mux-gpios = <&bmcgpio 0x2c 0x00>, <&bmcgpio 0x2d 0x00>;

		i2c@0 {
			/* QU5 Y0: aux panel + (via QU9) TPM hdr + PCIe SMBus */
			reg = <0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
		};

		i2c@2 {
			/* QU5 Y2 = I2C10: DIMM A-D bank (SPD 0x50-0x57) */
			reg = <0x02>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			/*
			 * Rig population: slot A2 (SA-strap map §5b). The real
			 * A2 module (RMR5030EF68F9W1600, SPD read on silicon) is
			 * a UDIMM with byte32=0 = no thermal sensor, so no jc42
			 * TSOD node (0x19 NAKs). A TS-equipped DIMM adds temp@19.
			 */
			spd@51 {
				compatible = "atmel,24c02";
				reg = <0x51>;
				read-only;
			};
		};

		i2c@3 {
			/* QU5 Y3 = I2C11: DIMM E-H bank (empty on the rig) */
			reg = <0x03>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
		};
	};

	/*
	 * VGA/graphics aperture (F8 / VGA-corruption fix, hardware-verified
	 * 2026-07-13). On the AST2050 the BMC and the host's onboard VGA are the
	 * SAME silicon sharing this one DRAM: the host's video adapter frame-buffers
	 * out of the top of BMC DRAM. Size = SCU70[3:2] strap (mirrored MCR04[5:4]),
	 * hardware-verified 8 MB here (MCR04=0x585, bits[5:4]=00). This node was
	 * MISSING from the real-HW DTB build, so the BMC kernel allocated into the
	 * framebuffer region and hung when the host wrote the VGA (BIOS POST / the
	 * host `ast` DRM driver). no-map fences the BMC kernel out; the video engine
	 * can still ioremap it to capture. Same pattern as the C410X vga_memory node.
	 */
	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		vga_memory: region@43800000 {
			no-map;
			reg = <0x43800000 0x800000>;	/* top 8 MB */
		};
	};

	ahb {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		spi@1e620000 {
			reg = <0x1e620000 0x94 0x20000000 0x10000000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "aspeed,ast2400-fmc";
			clocks = <0x02 0x19>;
			status = "disabled";
			interrupts = <0x13>;

			flash@0 {
				reg = <0x00>;
				compatible = "jedec,spi-nor";
				spi-rx-bus-width = <0x02>;
				spi-max-frequency = <0x2faf080>;
				status = "disabled";
			};

			flash@1 {
				reg = <0x01>;
				compatible = "jedec,spi-nor";
				spi-rx-bus-width = <0x02>;
				spi-max-frequency = <0x2faf080>;
				status = "disabled";
			};

			flash@2 {
				reg = <0x02>;
				compatible = "jedec,spi-nor";
				spi-rx-bus-width = <0x02>;
				spi-max-frequency = <0x2faf080>;
				status = "disabled";
			};

			flash@3 {
				reg = <0x03>;
				compatible = "jedec,spi-nor";
				spi-rx-bus-width = <0x02>;
				spi-max-frequency = <0x2faf080>;
				status = "disabled";
			};

			flash@4 {
				reg = <0x04>;
				compatible = "jedec,spi-nor";
				spi-rx-bus-width = <0x02>;
				spi-max-frequency = <0x2faf080>;
				status = "disabled";
			};
		};

		spi@1e630000 {
			reg = <0x1e630000 0x18 0x30000000 0x10000000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "aspeed,ast2400-spi";
			clocks = <0x02 0x19>;
			status = "disabled";

			flash@0 {
				reg = <0x00>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				spi-rx-bus-width = <0x02>;
				status = "disabled";
			};
		};

		interrupt-controller@1e6c0080 {
			compatible = "aspeed,ast2400-vic";
			interrupt-controller;
			#interrupt-cells = <0x01>;
			valid-sources = <0xffffffff 0x7ffff>;
			reg = <0x1e6c0080 0x80>;
			phandle = <0x01>;
		};

		copro-interrupt-controller@1e6c2000 {
			compatible = "aspeed,ast2400-cvic", "aspeed-cvic";
			valid-sources = <0x7fffffff>;
			reg = <0x1e6c2000 0x80>;
		};

		ethernet@1e660000 {
			compatible = "aspeed,ast2050-mac", "aspeed,ast2400-mac", "faraday,ftgmac100";
			reg = <0x1e660000 0x180>;
			interrupts = <0x02>;
			clocks = <0x02 0x11>;
			status = "okay";
			phy-mode = "rmii";
			/* Real HW: no fixed-link (that's a QEMU-ism -- QEMU's ftgmac100 has
			 * no PHY). The ftgmac100 driver auto-scans its embedded MDIO and
			 * connects to the real PHY (U-Boot finds it at MDIO addr 0x20), so
			 * eth0 actually negotiates a link and can reach the NFS server. */
		};

		ethernet@1e680000 {
			compatible = "aspeed,ast2400-mac", "faraday,ftgmac100";
			reg = <0x1e680000 0x180>;
			interrupts = <0x03>;
			clocks = <0x02 0x12>;
			status = "disabled";
		};

		usb@1e6a1000 {
			compatible = "aspeed,ast2400-ehci", "generic-ehci";
			reg = <0x1e6a1000 0x100>;
			interrupts = <0x05>;
			clocks = <0x02 0x0c>;
			pinctrl-names = "default";
			pinctrl-0 = <0x03>;
			status = "disabled";
		};

		usb@1e6b0000 {
			compatible = "aspeed,ast2400-uhci", "generic-uhci";
			reg = <0x1e6b0000 0x100>;
			interrupts = <0x0e>;
			#ports = <0x03>;
			clocks = <0x02 0x09>;
			status = "disabled";
		};

		usb-vhub@1e6a0000 {
			compatible = "aspeed,ast2400-usb-vhub";
			reg = <0x1e6a0000 0x300>;
			interrupts = <0x05>;
			clocks = <0x02 0x0c>;
			aspeed,vhub-downstream-ports = <0x05>;
			aspeed,vhub-generic-endpoints = <0x0f>;
			pinctrl-names = "default";
			pinctrl-0 = <0x04>;
			status = "disabled";
		};

		apb {
			compatible = "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;

			syscon@1e6e2000 {
				compatible = "aspeed,ast2050-scu", "aspeed,ast2400-scu", "syscon", "simple-mfd";
				reg = <0x1e6e2000 0x1a8>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x1e6e2000 0x1000>;
				#clock-cells = <0x01>;
				#reset-cells = <0x01>;
				phandle = <0x02>;

				p2a-control@2c {
					reg = <0x2c 0x04>;
					compatible = "aspeed,ast2400-p2a-ctrl";
					status = "disabled";
				};

				silicon-id@7c {
					compatible = "aspeed,ast2400-silicon-id", "aspeed,silicon-id";
					reg = <0x7c 0x04>;
				};

				pinctrl@80 {
					reg = <0x80 0x18 0xa0 0x10>;
					/*
					 * ast2050-pinctrl = the G4 driver with
					 * the G3 strap-phantom quirk (kernel
					 * patch 0008): G4-table functions
					 * gated purely on HW_STRAP1/2 bits
					 * must not block GPIO requests — the
					 * G3 SCU70 layout differs (silicon
					 * SCU70=0x00819582 has bit19=0, which
					 * the G4 table misreads as the ACPI
					 * function owning ball A19/GPIOF5).
					 */
					compatible = "aspeed,ast2050-pinctrl";
					phandle = <0x05>;

					acpi_default {
						function = "ACPI";
						groups = "ACPI";
					};

					adc0_default {
						function = "ADC0";
						groups = "ADC0";
					};

					adc1_default {
						function = "ADC1";
						groups = "ADC1";
					};

					adc10_default {
						function = "ADC10";
						groups = "ADC10";
					};

					adc11_default {
						function = "ADC11";
						groups = "ADC11";
					};

					adc12_default {
						function = "ADC12";
						groups = "ADC12";
					};

					adc13_default {
						function = "ADC13";
						groups = "ADC13";
					};

					adc14_default {
						function = "ADC14";
						groups = "ADC14";
					};

					adc15_default {
						function = "ADC15";
						groups = "ADC15";
					};

					adc2_default {
						function = "ADC2";
						groups = "ADC2";
					};

					adc3_default {
						function = "ADC3";
						groups = "ADC3";
					};

					adc4_default {
						function = "ADC4";
						groups = "ADC4";
					};

					adc5_default {
						function = "ADC5";
						groups = "ADC5";
					};

					adc6_default {
						function = "ADC6";
						groups = "ADC6";
					};

					adc7_default {
						function = "ADC7";
						groups = "ADC7";
					};

					adc8_default {
						function = "ADC8";
						groups = "ADC8";
					};

					adc9_default {
						function = "ADC9";
						groups = "ADC9";
					};

					bmcint_default {
						function = "BMCINT";
						groups = "BMCINT";
					};

					ddcclk_default {
						function = "DDCCLK";
						groups = "DDCCLK";
					};

					ddcdat_default {
						function = "DDCDAT";
						groups = "DDCDAT";
					};

					extrst_default {
						function = "EXTRST";
						groups = "EXTRST";
