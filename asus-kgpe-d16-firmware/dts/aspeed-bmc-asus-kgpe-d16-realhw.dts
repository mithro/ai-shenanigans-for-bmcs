					};

					vpi18_default {
						function = "VPI18";
						groups = "VPI18";
					};

					vpi24_default {
						function = "VPI24";
						groups = "VPI24";
					};

					vpi30_default {
						function = "VPI30";
						groups = "VPI30";
					};

					vpo12_default {
						function = "VPO12";
						groups = "VPO12";
					};

					vpo24_default {
						function = "VPO24";
						groups = "VPO24";
					};

					wdtrst1_default {
						function = "WDTRST1";
						groups = "WDTRST1";
					};

					wdtrst2_default {
						function = "WDTRST2";
						groups = "WDTRST2";
