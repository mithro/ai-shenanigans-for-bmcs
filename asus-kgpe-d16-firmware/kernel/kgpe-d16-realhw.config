# ASUS KGPE-D16 BMC (AST2050) — real-hardware kernel config fragment.
# Merged ON TOP of aspeed_g4_defconfig + kgpe-d16.config for booting on the REAL
# board (vs the QEMU machine). Adds an NFS root so the OpenBMC/dev filesystem can
# live on the Pi (like the RPis in fpgas.online) instead of a tiny in-RAM initramfs
# — the 64 MB DRAM can't hold a full OpenBMC rootfs.
#
# Build: make aspeed_g4_defconfig
#        merge_config.sh -m .config kgpe-d16.config kgpe-d16-realhw.config
#        make olddefconfig && make uImage dtbs

# --- ARM PL190 VIC (the REAL AST2050 interrupt controller) ---
# The AST2050 (G3) interrupt controller is an ARM PL190 VIC at 0x1e6c0000, NOT the
# AST2400+ "aspeed,ast2400-vic" (interleaved map @ 0x1e6c0080). The mainline aspeed
# VIC driver writes SENSE/EVENT/ENABLE registers the G3 lacks -> no IRQ is ever
# enabled -> the timer clockevent is dead -> hrtimers hang -> ndo_open hangs. Use the
# mainline ARM VIC driver (irq-vic.c) with a arm,pl190-vic DT node @ 0x1e6c0000.
CONFIG_ARM_VIC=y
CONFIG_ARM_VIC_NR=1

# --- Kernel-level IP autoconfiguration (brings eth0 up before mounting NFS) ---
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y

# --- NFS client + NFS root ---
# NFS_FS is gated behind NETWORK_FILESYSTEMS, which aspeed_g4_defconfig leaves off;
# without it NFS_FS (and thus ROOT_NFS) silently drop out at olddefconfig.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_ROOT_NFS=y

# --- Filesystems a real rootfs needs (defconfig usually has these; be explicit) ---
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# --- Disable netconsole ---
# aspeed_g4_defconfig builds netconsole in; it registers a netcon0 console and its
# netpoll setup can stall early boot on a real PHY that is still negotiating a link
# (the fixed-link QEMU path had an instant carrier, so it never showed). A BMC does
# not need it, and it competes with the NFS-root IP-config for eth0.
# CONFIG_NETCONSOLE is not set
