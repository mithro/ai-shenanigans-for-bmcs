# ASUS KGPE-D16 BMC (AST2050) — NFS-root / netboot kernel config fragment.
# Merged ON TOP of kgpe-d16.config for the Phase-6 "OpenBMC over TFTP+NFS" boot:
# the kernel is TFTP-loaded by U-Boot (or -kernel), auto-configures its IP over the
# FTGMAC100 NIC (DHCP from QEMU slirp), and mounts its root filesystem over NFS.
#
# Kernel cmdline for this path (slirp gateway = host = 10.0.2.2):
#   root=/dev/nfs rw ip=dhcp \
#     nfsroot=10.0.2.2:/export/kgpe-d16-rootfs,vers=3,tcp \
#     console=ttyS4,115200n8
#
# See qemu-model/PHASE6-OPENBMC-TFTP-NFS.md.

# --- Kernel-level IP autoconfiguration (for nfsroot before userspace) ---
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y

# --- NFS client + root-over-NFS ---
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_ROOT_NFS=y

# --- Lock manager / sunrpc are pulled in by NFS; make sure they're built-in ---
CONFIG_SUNRPC=y
CONFIG_LOCKD=y
