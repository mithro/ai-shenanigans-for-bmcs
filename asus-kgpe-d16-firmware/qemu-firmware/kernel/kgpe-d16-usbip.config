# ASUS KGPE-D16 BMC (AST2050) — USB/IP (feature #2/#3b host-enumeration) config.
# Merged AFTER kgpe-d16-usb.config, which already provides the gadget stack
# (USB_GADGET, LIBCOMPOSITE, CONFIGFS f_hid + mass_storage).
#
# WHY: the existing F6/F8 demos bind the gadget to dummy_hcd and loop it back
# INSIDE the BMC guest, so it never reaches an independent host. To prove FULL
# enumeration against a real (virtual) host in emulation, the BMC exports its
# configfs gadget over USB/IP: bind the gadget to the usbip-vudc UDC, then
# `usbipd --device` serialises its URBs over TCP:3240 to a second qemu-system-
# x86_64 guest that imports it via vhci-hcd (see scripts/usbip-host-test.py).
# See openbmc/bmc-functionality/F6-USB-HOST.md.

# USB/IP core + the Virtual UDC (device/server side). usbip-vudc is itself a
# software UDC: `echo usbip-vudc.0 > .../UDC` binds the gadget to it. This is the
# UDC-agnostic FUNCTION/enumeration test — complementary to (not a replacement
# for) the faithful aspeed.udc-ast2050 vhub probe test (a gadget binds ONE UDC at
# a time; see VHUB-G3-PORT-PLAN.md / F6-USB-HOST.md §limits).
CONFIG_USBIP_CORE=y
CONFIG_USBIP_VUDC=y

# NOT set on the BMC: CONFIG_USBIP_HOST (re-exports a device already seen by a USB
# *host* controller — the AST2050 has none) and CONFIG_USBIP_VHCI_HCD (the import
# side; that belongs on the x86 virtual-host guest, see kernel/vhost-x86.config).
