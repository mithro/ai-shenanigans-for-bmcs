+/*
+ * Build the standard JFIF header for the G3 (jpeg_only) software wrapper.
+ *
+ * The AST2050 (G3) video engine emits a *headerless* raw entropy stream: unlike
+ * the AST2400+, register 0x040 is the CRC buffer (not the JPEG header buffer),
+ * so the engine never DMA-prepends the JFIF header the way the G4 does. To make
+ * /dev/video0 return a standards-compliant V4L2_PIX_FMT_JPEG, the driver builds
+ * the header itself -- jpeg_header + jpeg_dct[sel] + jpeg_quant, the very tables
+ * the G4 engine would have laid down -- and aspeed_video_irq() prepends it to
+ * each captured frame. The static tables ship SOF0 (FF C0) height/width = 0 (the
+ * G4 engine patches them in HW); we patch them here to the captured resolution.
+ *
+ * Rebuilt only when the resolution or JPEG quality changes.
+ */
+static void aspeed_video_build_jfif_header(struct aspeed_video *video)
+{
+	u8 sel = min_t(u8, video->jpeg_quality, 7);
+	u16 width = video->pix_fmt.width;
+	u16 height = video->pix_fmt.height;
+	u8 *h = video->jpeg_hdr;
+	unsigned long flags;
+	u32 sof;
+
+	if (!video->jpeg_only)
+		return;
+
+	/*
+	 * jpeg_hdr[] + the *_len/sel/w/h cache are shared with the hard-IRQ
+	 * reader aspeed_video_wrap_jfif() (under video->lock); this builder
+	 * runs in process context (incl. a mid-stream VIDIOC_S_CTRL), so take
+	 * the same lock — irqsave here pairs with the plain spin_lock() in the
+	 * IRQ handler — to avoid emitting a torn JFIF header.
+	 */
+	spin_lock_irqsave(&video->lock, flags);
+
+	if (video->jpeg_hdr_len && video->jpeg_hdr_sel == sel &&
+	    video->jpeg_hdr_w == width && video->jpeg_hdr_h == height) {
+		spin_unlock_irqrestore(&video->lock, flags);
+		return;			/* already current */
+	}
+
+	memcpy(h, aspeed_video_jpeg_header, sizeof(aspeed_video_jpeg_header));
+	h += sizeof(aspeed_video_jpeg_header);
+	memcpy(h, aspeed_video_jpeg_dct[sel], sizeof(aspeed_video_jpeg_dct[sel]));
+	h += sizeof(aspeed_video_jpeg_dct[sel]);
+	memcpy(h, aspeed_video_jpeg_quant, sizeof(aspeed_video_jpeg_quant));
+
+	/*
+	 * SOF0 straddles the dct/quant boundary: jpeg_dct[] ends in 0xFF and
+	 * jpeg_quant[] starts with 0xC0. From the marker the layout is
+	 * FF C0 | len(2) | prec(1) | height(2,BE) | width(2,BE) | ncomp ... so
+	 * height is at +5 and width at +7. Patch the captured resolution in.
+	 */
+	sof = sizeof(aspeed_video_jpeg_header) +
+	      sizeof(aspeed_video_jpeg_dct[sel]) - 1;
+	h = video->jpeg_hdr;
+	if (h[sof] == 0xff && h[sof + 1] == 0xc0) {
+		h[sof + 5] = height >> 8;
+		h[sof + 6] = height & 0xff;
+		h[sof + 7] = width >> 8;
+		h[sof + 8] = width & 0xff;
+	} else {
+		v4l2_warn(&video->v4l2_dev,
+			  "JFIF SOF0 not at offset %u (%02x %02x); dims unpatched\n",
+			  sof, h[sof], h[sof + 1]);
+	}
+
+	video->jpeg_hdr_len = ASPEED_VIDEO_JFIF_HDR_SIZE;
+	video->jpeg_hdr_sel = sel;
+	video->jpeg_hdr_w = width;
+	video->jpeg_hdr_h = height;
+
+	spin_unlock_irqrestore(&video->lock, flags);
+
+	v4l2_dbg(1, debug, &video->v4l2_dev,
+		 "built JFIF header: %ux%u sel=%u len=%u\n",
+		 width, height, sel, video->jpeg_hdr_len);
+}
+
+/*
+ * Wrap the engine's raw entropy stream into a standards-compliant JPEG: shift
+ * the entropy up by the header length, prepend the pre-built JFIF header, and
+ * append the EOI marker. The G3 writes the entropy verbatim (MSB-first byte
+ * stream -- no word-swap needed), so this is a pure rearrange. Returns the
+ * resulting payload size.
+ *
+ * Runs in aspeed_video_irq() threaded-IRQ context under video->lock; the
+ * memmove is bounded by the frame size and never sleeps.
+ */
+static u32 aspeed_video_wrap_jfif(struct aspeed_video *video,
+				  struct aspeed_video_buffer *buf, u32 frame_size)
+{
+	u8 *vaddr = vb2_plane_vaddr(&buf->vb.vb2_buf, 0);
+	u32 hlen = video->jpeg_hdr_len;
+	u32 total = hlen + frame_size + 2;	/* header + entropy + EOI */
+
+	if (!vaddr || !hlen)
+		return frame_size;
+
+	if (total > video->pix_fmt.sizeimage) {
+		v4l2_warn(&video->v4l2_dev,
+			  "frame %u + JFIF %u > buffer %u; emitting raw stream\n",
+			  frame_size, hlen, video->pix_fmt.sizeimage);
+		return frame_size;
+	}
+
+	memmove(vaddr + hlen, vaddr, frame_size);
+	memcpy(vaddr, video->jpeg_hdr, hlen);
+	vaddr[hlen + frame_size] = 0xff;	/* EOI marker */
+	vaddr[hlen + frame_size + 1] = 0xd9;
+
+	return total;
+}
