+/*
+ * Modern hwmon interface (hwmon_device_register_with_info) exposing the sensor
+ * *_input values under /sys/class/hwmon/hwmonN/ with a "name" file. The legacy
+ * hwmon_device_register() this driver used only created the attributes on the
+ * i2c client device (hwmonN/device/) and left hwmonN nameless, which modern
+ * hwmon consumers (e.g. OpenBMC phosphor-hwmon, which reads hwmonN/<type>N_input
+ * and hwmonN/name directly) cannot see. The rich limit/alarm/pwm attributes stay
+ * on the i2c client via w83795_handle_files(); this only adds the input channels
+ * the standard hwmon ABI expects.
+ */
+static umode_t w83795_is_visible(const void *drvdata,
+				 enum hwmon_sensor_types type,
+				 u32 attr, int channel)
+{
+	const struct w83795_data *data = drvdata;
+
+	switch (type) {
+	case hwmon_in:
+		if (data->has_in & (1 << channel))
+			return 0444;
+		break;
+	case hwmon_fan:
+		if (data->has_fan & (1 << channel))
+			return 0444;
+		break;
+	case hwmon_temp:
+		if (channel < 6) {
+			if (data->has_temp & (1 << channel))
+				return 0444;
+		} else {
+			if (data->has_dts & (1 << (channel - 6)))
+				return 0444;
+		}
+		break;
+	case hwmon_intrusion:
+		return 0644;	/* intrusion0_alarm: read CASEOPEN latch, write 0 clears */
+	default:
+		break;
+	}
+	return 0;
+}
+
+static int w83795_hwmon_read(struct device *dev, enum hwmon_sensor_types type,
+			     u32 attr, int channel, long *val)
+{
+	struct w83795_data *data = w83795_update_device(dev);
+
+	switch (type) {
+	case hwmon_in:
+		*val = in_from_reg(channel, data->in[channel][IN_READ]);
+		return 0;
+	case hwmon_fan:
+		*val = fan_from_reg(data->fan[channel]);
+		return 0;
+	case hwmon_temp:
+		if (channel < 6)
+			*val = temp_from_reg(data->temp[channel][TEMP_READ]) +
+			       (data->temp_read_vrlsb[channel] >> 6) * 250;
+		else
+			*val = temp_from_reg(data->dts[channel - 6]) +
+			       (data->dts_read_vrlsb[channel - 6] >> 6) * 250;
+		return 0;
+	case hwmon_intrusion:
+		/* chassis-intrusion (CASEOPEN): ALARM(5) bit6, latched by update */
+		*val = !!(data->alarms[5] & (1 << 6));
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static int w83795_hwmon_write(struct device *dev, enum hwmon_sensor_types type,
+			      u32 attr, int channel, long val)
+{
+	struct w83795_data *data = dev_get_drvdata(dev);
+	struct i2c_client *client = data->client;
+	u8 tmp;
+
+	if (type != hwmon_intrusion)
+		return -EOPNOTSUPP;
+	/* Only "echo 0 > intrusion0_alarm" (clear the CASEOPEN latch) is defined. */
+	if (val != 0)
+		return -EINVAL;
+
+	mutex_lock(&data->update_lock);
+	tmp = w83795_read(client, W83795_REG_CLR_CHASSIS);
+	w83795_write(client, W83795_REG_CLR_CHASSIS, tmp | 0x80);
+	w83795_read(client, W83795_REG_ALARM(5));	/* refresh the latch */
+	data->valid = false;
+	mutex_unlock(&data->update_lock);
+	return 0;
+}
+
+static const struct hwmon_channel_info * const w83795_hwmon_info[] = {
+	HWMON_CHANNEL_INFO(in,
+		HWMON_I_INPUT, HWMON_I_INPUT, HWMON_I_INPUT, HWMON_I_INPUT,
+		HWMON_I_INPUT, HWMON_I_INPUT, HWMON_I_INPUT, HWMON_I_INPUT,
+		HWMON_I_INPUT, HWMON_I_INPUT, HWMON_I_INPUT, HWMON_I_INPUT,
+		HWMON_I_INPUT, HWMON_I_INPUT, HWMON_I_INPUT, HWMON_I_INPUT,
+		HWMON_I_INPUT, HWMON_I_INPUT, HWMON_I_INPUT, HWMON_I_INPUT,
+		HWMON_I_INPUT),
+	HWMON_CHANNEL_INFO(fan,
+		HWMON_F_INPUT, HWMON_F_INPUT, HWMON_F_INPUT, HWMON_F_INPUT,
+		HWMON_F_INPUT, HWMON_F_INPUT, HWMON_F_INPUT, HWMON_F_INPUT,
+		HWMON_F_INPUT, HWMON_F_INPUT, HWMON_F_INPUT, HWMON_F_INPUT,
+		HWMON_F_INPUT, HWMON_F_INPUT),
+	HWMON_CHANNEL_INFO(temp,
+		HWMON_T_INPUT, HWMON_T_INPUT, HWMON_T_INPUT, HWMON_T_INPUT,
+		HWMON_T_INPUT, HWMON_T_INPUT, HWMON_T_INPUT, HWMON_T_INPUT,
+		HWMON_T_INPUT, HWMON_T_INPUT, HWMON_T_INPUT, HWMON_T_INPUT,
+		HWMON_T_INPUT, HWMON_T_INPUT),
+	HWMON_CHANNEL_INFO(intrusion,
+		HWMON_INTRUSION_ALARM),
+	NULL
+};
+
+static const struct hwmon_ops w83795_hwmon_ops = {
+	.is_visible = w83795_is_visible,
+	.read = w83795_hwmon_read,
+	.write = w83795_hwmon_write,
+};
+
+static const struct hwmon_chip_info w83795_chip_info = {
+	.ops = &w83795_hwmon_ops,
+	.info = w83795_hwmon_info,
+};
+
 static const struct i2c_device_id w83795_id[];
 
 static int w83795_probe(struct i2c_client *client)
@@ -2149,6 +2277,7 @@ static int w83795_probe(struct i2c_client *client)
 		return -ENOMEM;
 
 	i2c_set_clientdata(client, data);
+	data->client = client;
 	data->chip_type = i2c_match_id(w83795_id, client)->driver_data;
 	data->bank = i2c_smbus_read_byte_data(client, W83795_REG_BANKSEL);
 	mutex_init(&data->update_lock);
@@ -2222,7 +2351,8 @@ static int w83795_probe(struct i2c_client *client)
 	if (data->chip_type == w83795g)
 		w83795_check_dynamic_in_limits(client);
 
