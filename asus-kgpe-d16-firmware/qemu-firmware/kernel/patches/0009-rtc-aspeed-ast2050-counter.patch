diff --git a/drivers/rtc/rtc-aspeed.c b/drivers/rtc/rtc-aspeed.c
index 880b015ee..78f0737f9 100644
--- a/drivers/rtc/rtc-aspeed.c
+++ b/drivers/rtc/rtc-aspeed.c
@@ -3,15 +3,35 @@
 
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/of_device.h>
 #include <linux/platform_device.h>
 #include <linux/rtc.h>
 #include <linux/io.h>
 
+/*
+ * The ASPEED SoCs expose two DIFFERENT RTC designs at 0x1E781000:
+ *  - AST2400/2500/2600: a BCD/CMOS-style RTC with a TIME + YEAR register and an
+ *    unlock/enable control at 0x10 (the original aspeed_rtc_config below).
+ *  - AST2050 (G3): a COUNTER-style RTC (datasheet §24) with a read-only live
+ *    COUNTER (0x00), a RELOAD value (0x08), a CONTROL with an enable bit (0x0C),
+ *    and a RESTART register (0x10) that latches RELOAD into COUNTER on a 0x5A
+ *    write.  It has NO month/year register — it tracks time-of-day plus a day
+ *    counter only (a hardware limitation).  The mainline aspeed-rtc driver's
+ *    register map does not fit it (0x10 is RESTART here, not CTRL), which is why
+ *    a dedicated counter-style variant is needed; matches the QEMU G3 model and
+ *    the silicon-validated Zephyr rtc_aspeed_g3.c.
+ */
+struct aspeed_rtc_config {
+	bool counter_style;
+};
+
 struct aspeed_rtc {
 	struct rtc_device *rtc_dev;
 	void __iomem *base;
+	const struct aspeed_rtc_config *config;
 };
 
+/* AST2400/2500/2600 BCD/CMOS layout */
 #define RTC_TIME	0x00
 #define RTC_YEAR	0x04
 #define RTC_CTRL	0x10
@@ -19,12 +39,50 @@ struct aspeed_rtc {
 #define RTC_UNLOCK	BIT(1)
 #define RTC_ENABLE	BIT(0)
 
+/* AST2050 (G3) counter-style layout (datasheet §24) */
+#define G3_RTC_COUNTER		0x00	/* RO live count, byte-packed */
+#define G3_RTC_RELOAD		0x08	/* value latched into COUNTER on RESTART */
+#define G3_RTC_CONTROL		0x0C	/* [0] enable */
+#define G3_RTC_RESTART		0x10	/* write 0x5A -> COUNTER := RELOAD */
+#define G3_RTC_CTRL_ENABLE	BIT(0)
+#define G3_RTC_RESTART_MAGIC	0x5A
+
 static int aspeed_rtc_read_time(struct device *dev, struct rtc_time *tm)
 {
 	struct aspeed_rtc *rtc = dev_get_drvdata(dev);
 	unsigned int cent, year;
 	u32 reg1, reg2;
 
+	if (rtc->config->counter_style) {
+		unsigned int day;
+
+		if (!(readl(rtc->base + G3_RTC_CONTROL) & G3_RTC_CTRL_ENABLE)) {
+			dev_dbg(dev, "%s failing as rtc disabled\n", __func__);
+			return -EINVAL;
+		}
+
+		reg1 = readl(rtc->base + G3_RTC_COUNTER);
+		tm->tm_sec  = (reg1 >>  0) & 0xff;
+		tm->tm_min  = (reg1 >>  8) & 0xff;
+		tm->tm_hour = (reg1 >> 16) & 0xff;
+		day         = (reg1 >> 24) & 0xff;
+
+		/*
+		 * The counter-style RTC has no month/year and its "day" is a plain
+		 * up-counter, not a calendar day-of-month.  Report a fixed calendar
+		 * base so the rtc core gets a valid struct; the meaningful fields are
+		 * sec/min/hour.  Clamp the day counter into a valid mday (1..28) so
+		 * rtc_valid_tm() accepts it regardless of how far the (crystal-less,
+		 * fast) counter has advanced.
+		 */
+		tm->tm_mday = day ? (((day - 1) % 28) + 1) : 1;
+		tm->tm_mon  = 0;	/* January */
+		tm->tm_year = 100;	/* 2000 */
+
+		dev_dbg(dev, "%s %ptR (counter day=%u)", __func__, tm, day);
+		return 0;
+	}
+
 	if (!(readl(rtc->base + RTC_CTRL) & RTC_ENABLE)) {
 		dev_dbg(dev, "%s failing as rtc disabled\n", __func__);
 		return -EINVAL;
@@ -56,6 +114,24 @@ static int aspeed_rtc_set_time(struct device *dev, struct rtc_time *tm)
 	u32 reg1, reg2, ctrl;
 	int year, cent;
 
+	if (rtc->config->counter_style) {
+		/*
+		 * Program the byte-packed time-of-day + day into RELOAD, pulse
+		 * RESTART (0x5A) to latch it into the live COUNTER, then enable the
+		 * counter.  year/month are not stored (no register for them).
+		 */
+		reg1 = (((u32)tm->tm_mday & 0xff) << 24) |
+		       (((u32)tm->tm_hour & 0xff) << 16) |
+		       (((u32)tm->tm_min  & 0xff) <<  8) |
+		        ((u32)tm->tm_sec  & 0xff);
+
+		writel(reg1, rtc->base + G3_RTC_RELOAD);
+		writel(G3_RTC_RESTART_MAGIC, rtc->base + G3_RTC_RESTART);
+		ctrl = readl(rtc->base + G3_RTC_CONTROL);
+		writel(ctrl | G3_RTC_CTRL_ENABLE, rtc->base + G3_RTC_CONTROL);
+		return 0;
+	}
+
 	cent = (tm->tm_year + 1900) / 100;
 	year = tm->tm_year % 100;
 
@@ -90,6 +166,10 @@ static int aspeed_rtc_probe(struct platform_device *pdev)
 	if (!rtc)
 		return -ENOMEM;
 
+	rtc->config = of_device_get_match_data(&pdev->dev);
+	if (!rtc->config)
+		return -EINVAL;
+
 	rtc->base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(rtc->base))
 		return PTR_ERR(rtc->base);
@@ -107,10 +187,14 @@ static int aspeed_rtc_probe(struct platform_device *pdev)
 	return devm_rtc_register_device(rtc->rtc_dev);
 }
 
+static const struct aspeed_rtc_config config_bcd = { .counter_style = false };
+static const struct aspeed_rtc_config config_counter = { .counter_style = true };
+
 static const struct of_device_id aspeed_rtc_match[] = {
-	{ .compatible = "aspeed,ast2400-rtc", },
-	{ .compatible = "aspeed,ast2500-rtc", },
-	{ .compatible = "aspeed,ast2600-rtc", },
+	{ .compatible = "aspeed,ast2400-rtc", .data = &config_bcd },
+	{ .compatible = "aspeed,ast2500-rtc", .data = &config_bcd },
+	{ .compatible = "aspeed,ast2600-rtc", .data = &config_bcd },
+	{ .compatible = "aspeed,ast2050-rtc", .data = &config_counter },
 	{}
 };
 MODULE_DEVICE_TABLE(of, aspeed_rtc_match);
