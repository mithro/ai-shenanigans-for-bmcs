diff --git a/drivers/rtc/rtc-aspeed.c b/drivers/rtc/rtc-aspeed.c
index 880b015ee..82a49a518 100644
--- a/drivers/rtc/rtc-aspeed.c
+++ b/drivers/rtc/rtc-aspeed.c
@@ -1,17 +1,48 @@
 // SPDX-License-Identifier: GPL-2.0+
 // Copyright 2015 IBM Corp.
 
+#include <linux/interrupt.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/of_device.h>
 #include <linux/platform_device.h>
 #include <linux/rtc.h>
 #include <linux/io.h>
+#include <linux/spinlock.h>
+
+/*
+ * The ASPEED SoCs expose two DIFFERENT RTC designs at 0x1E781000:
+ *  - AST2400/2500/2600: a BCD/CMOS-style RTC with a TIME + YEAR register and an
+ *    unlock/enable control at 0x10 (the original aspeed_rtc_config below).
+ *  - AST2050 (G3): a COUNTER-style RTC (datasheet §24) with a read-only live
+ *    COUNTER (0x00), a RELOAD value (0x08), a CONTROL with an enable bit (0x0C),
+ *    and a RESTART register (0x10) that latches RELOAD into COUNTER on a 0x5A
+ *    write.  It has NO month/year register — it tracks time-of-day plus a day
+ *    counter only (a hardware limitation).  The mainline aspeed-rtc driver's
+ *    register map does not fit it (0x10 is RESTART here, not CTRL), which is why
+ *    a dedicated counter-style variant is needed; matches the QEMU G3 model and
+ *    the silicon-validated Zephyr rtc_aspeed_g3.c.
+ */
+struct aspeed_rtc_config {
+	bool counter_style;
+};
 
 struct aspeed_rtc {
 	struct rtc_device *rtc_dev;
 	void __iomem *base;
+	const struct aspeed_rtc_config *config;
+	/*
+	 * Serialises read-modify-write of the counter-style CONTROL register,
+	 * which is touched from both process context (set_time / set_alarm /
+	 * alarm_irq_enable) and the hard-IRQ alarm handler.  Without it a
+	 * mid-RMW preempt could lose the alarm-disable (re-arming a consumed
+	 * one-shot) or the RTC master-enable bit — a race made easy to hit by
+	 * this board's ~732x-accelerated counter (alarm fires in ~7 ms).
+	 */
+	spinlock_t lock;
 };
 
+/* AST2400/2500/2600 BCD/CMOS layout */
 #define RTC_TIME	0x00
 #define RTC_YEAR	0x04
 #define RTC_CTRL	0x10
@@ -19,12 +50,50 @@ struct aspeed_rtc {
 #define RTC_UNLOCK	BIT(1)
 #define RTC_ENABLE	BIT(0)
 
+/* AST2050 (G3) counter-style layout (datasheet §24) */
+#define G3_RTC_COUNTER		0x00	/* RO live count, byte-packed */
+#define G3_RTC_RELOAD		0x08	/* value latched into COUNTER on RESTART */
+#define G3_RTC_CONTROL		0x0C	/* [0] enable */
+#define G3_RTC_RESTART		0x10	/* write 0x5A -> COUNTER := RELOAD */
+#define G3_RTC_CTRL_ENABLE	BIT(0)
+#define G3_RTC_RESTART_MAGIC	0x5A
+
 static int aspeed_rtc_read_time(struct device *dev, struct rtc_time *tm)
 {
 	struct aspeed_rtc *rtc = dev_get_drvdata(dev);
 	unsigned int cent, year;
 	u32 reg1, reg2;
 
+	if (rtc->config->counter_style) {
+		unsigned int day;
+
+		if (!(readl(rtc->base + G3_RTC_CONTROL) & G3_RTC_CTRL_ENABLE)) {
+			dev_dbg(dev, "%s failing as rtc disabled\n", __func__);
+			return -EINVAL;
+		}
+
+		reg1 = readl(rtc->base + G3_RTC_COUNTER);
+		tm->tm_sec  = (reg1 >>  0) & 0xff;
+		tm->tm_min  = (reg1 >>  8) & 0xff;
+		tm->tm_hour = (reg1 >> 16) & 0xff;
+		day         = (reg1 >> 24) & 0xff;
+
+		/*
+		 * The counter-style RTC has no month/year and its "day" is a plain
+		 * up-counter, not a calendar day-of-month.  Report a fixed calendar
+		 * base so the rtc core gets a valid struct; the meaningful fields are
+		 * sec/min/hour.  Clamp the day counter into a valid mday (1..28) so
+		 * rtc_valid_tm() accepts it regardless of how far the (crystal-less,
+		 * fast) counter has advanced.
+		 */
+		tm->tm_mday = day ? (((day - 1) % 28) + 1) : 1;
+		tm->tm_mon  = 0;	/* January */
+		tm->tm_year = 100;	/* 2000 */
+
+		dev_dbg(dev, "%s %ptR (counter day=%u)", __func__, tm, day);
+		return 0;
+	}
+
 	if (!(readl(rtc->base + RTC_CTRL) & RTC_ENABLE)) {
 		dev_dbg(dev, "%s failing as rtc disabled\n", __func__);
 		return -EINVAL;
@@ -53,9 +122,31 @@ static int aspeed_rtc_read_time(struct device *dev, struct rtc_time *tm)
 static int aspeed_rtc_set_time(struct device *dev, struct rtc_time *tm)
 {
 	struct aspeed_rtc *rtc = dev_get_drvdata(dev);
+	unsigned long flags;
 	u32 reg1, reg2, ctrl;
 	int year, cent;
 
+	if (rtc->config->counter_style) {
+		/*
+		 * Program the byte-packed time-of-day + day into RELOAD, pulse
+		 * RESTART (0x5A) to latch it into the live COUNTER, then enable the
+		 * counter.  year/month are not stored (no register for them).
+		 */
+		reg1 = (((u32)tm->tm_mday & 0xff) << 24) |
+		       (((u32)tm->tm_hour & 0xff) << 16) |
+		       (((u32)tm->tm_min  & 0xff) <<  8) |
+		        ((u32)tm->tm_sec  & 0xff);
+
+		writel(reg1, rtc->base + G3_RTC_RELOAD);
+		writel(G3_RTC_RESTART_MAGIC, rtc->base + G3_RTC_RESTART);
+		/* CONTROL RMW shared with the alarm IRQ handler — irq-safe lock. */
+		spin_lock_irqsave(&rtc->lock, flags);
+		ctrl = readl(rtc->base + G3_RTC_CONTROL);
+		writel(ctrl | G3_RTC_CTRL_ENABLE, rtc->base + G3_RTC_CONTROL);
+		spin_unlock_irqrestore(&rtc->lock, flags);
+		return 0;
+	}
+
 	cent = (tm->tm_year + 1900) / 100;
 	year = tm->tm_year % 100;
 
@@ -77,11 +168,98 @@ static int aspeed_rtc_set_time(struct device *dev, struct rtc_time *tm)
 	return 0;
 }
 
+/*
+ * Counter-style alarm (datasheet §24): the alarm register RTC04 holds a
+ * byte-packed hour/min/sec, and RTC0C[1:4] enable the second/minute/hour/day
+ * alarm.  The RTC raises its alarm interrupt (VIC 26) when the counter matches
+ * the enabled alarm fields.  The counter has no calendar, so the alarm is on
+ * time-of-day only — which is exactly what a wakealarm needs on this board.
+ */
+#define G3_RTC_ALARM		0x04
+#define G3_RTC_CTRL_ALARM_SEC	BIT(1)
+#define G3_RTC_CTRL_ALARM_MIN	BIT(2)
+#define G3_RTC_CTRL_ALARM_HOUR	BIT(3)
+#define G3_RTC_CTRL_ALARM_DAY	BIT(4)
+#define G3_RTC_CTRL_ALARM_MASK	(G3_RTC_CTRL_ALARM_SEC | G3_RTC_CTRL_ALARM_MIN | \
+				 G3_RTC_CTRL_ALARM_HOUR | G3_RTC_CTRL_ALARM_DAY)
+
+static void aspeed_rtc_alarm_enable(struct aspeed_rtc *rtc, bool enable)
+{
+	unsigned long flags;
+	u32 ctrl;
+
+	/* Match on hour:min:sec (not day — the counter's day is a free-running
+	 * up-counter, not a calendar day). CONTROL RMW is shared with set_time
+	 * and the IRQ handler, so it must be irq-safe locked (see struct). */
+	spin_lock_irqsave(&rtc->lock, flags);
+	ctrl = readl(rtc->base + G3_RTC_CONTROL);
+	if (enable)
+		ctrl |= G3_RTC_CTRL_ALARM_SEC | G3_RTC_CTRL_ALARM_MIN |
+			G3_RTC_CTRL_ALARM_HOUR;
+	else
+		ctrl &= ~G3_RTC_CTRL_ALARM_MASK;
+	writel(ctrl, rtc->base + G3_RTC_CONTROL);
+	spin_unlock_irqrestore(&rtc->lock, flags);
+}
+
+static int aspeed_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *alrm)
+{
+	struct aspeed_rtc *rtc = dev_get_drvdata(dev);
+	u32 reg = readl(rtc->base + G3_RTC_ALARM);
+
+	alrm->time.tm_sec  = (reg >>  0) & 0xff;
+	alrm->time.tm_min  = (reg >>  8) & 0xff;
+	alrm->time.tm_hour = (reg >> 16) & 0xff;
+	alrm->time.tm_mday = 1;
+	alrm->time.tm_mon  = 0;
+	alrm->time.tm_year = 100;
+	alrm->enabled = !!(readl(rtc->base + G3_RTC_CONTROL) &
+			   G3_RTC_CTRL_ALARM_MASK);
+	return 0;
+}
+
+static int aspeed_rtc_set_alarm(struct device *dev, struct rtc_wkalrm *alrm)
+{
+	struct aspeed_rtc *rtc = dev_get_drvdata(dev);
+	u32 reg;
+
+	reg = (((u32)alrm->time.tm_hour & 0xff) << 16) |
+	      (((u32)alrm->time.tm_min  & 0xff) <<  8) |
+	       ((u32)alrm->time.tm_sec  & 0xff);
+	writel(reg, rtc->base + G3_RTC_ALARM);
+	aspeed_rtc_alarm_enable(rtc, alrm->enabled);
+	return 0;
+}
+
+static int aspeed_rtc_alarm_irq_enable(struct device *dev, unsigned int enabled)
+{
+	aspeed_rtc_alarm_enable(dev_get_drvdata(dev), enabled);
+	return 0;
+}
+
+static irqreturn_t aspeed_rtc_alarm_irq(int irq, void *data)
+{
+	struct aspeed_rtc *rtc = data;
+
+	/* One-shot: disable the alarm so it does not re-fire, then report it. */
+	aspeed_rtc_alarm_enable(rtc, false);
+	rtc_update_irq(rtc->rtc_dev, 1, RTC_AF | RTC_IRQF);
+	return IRQ_HANDLED;
+}
+
 static const struct rtc_class_ops aspeed_rtc_ops = {
 	.read_time = aspeed_rtc_read_time,
 	.set_time = aspeed_rtc_set_time,
 };
 
+static const struct rtc_class_ops aspeed_rtc_counter_ops = {
+	.read_time = aspeed_rtc_read_time,
+	.set_time = aspeed_rtc_set_time,
+	.read_alarm = aspeed_rtc_read_alarm,
+	.set_alarm = aspeed_rtc_set_alarm,
+	.alarm_irq_enable = aspeed_rtc_alarm_irq_enable,
+};
+
 static int aspeed_rtc_probe(struct platform_device *pdev)
 {
 	struct aspeed_rtc *rtc;
@@ -90,6 +268,12 @@ static int aspeed_rtc_probe(struct platform_device *pdev)
 	if (!rtc)
 		return -ENOMEM;
 
+	rtc->config = of_device_get_match_data(&pdev->dev);
+	if (!rtc->config)
+		return -EINVAL;
+
+	spin_lock_init(&rtc->lock);
+
 	rtc->base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(rtc->base))
 		return PTR_ERR(rtc->base);
@@ -100,17 +284,40 @@ static int aspeed_rtc_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, rtc);
 
-	rtc->rtc_dev->ops = &aspeed_rtc_ops;
+	if (rtc->config->counter_style) {
+		int irq = platform_get_irq_optional(pdev, 0);
+
+		rtc->rtc_dev->ops = &aspeed_rtc_counter_ops;
+		/*
+		 * A working wakealarm needs both the alarm IRQ (VIC 26) AND the
+		 * device marked wakeup-capable (rtc_does_wakealarm() gates the
+		 * /sys wakealarm attr on device_can_wakeup(parent)). Enable both
+		 * only when the IRQ is present + requestable; otherwise drop the
+		 * alarm feature so userspace does not expect a wakealarm to fire.
+		 */
+		if (irq > 0 &&
+		    !devm_request_irq(&pdev->dev, irq, aspeed_rtc_alarm_irq, 0,
+				      dev_name(&pdev->dev), rtc))
+			device_init_wakeup(&pdev->dev, true);
+		else
+			clear_bit(RTC_FEATURE_ALARM, rtc->rtc_dev->features);
+	} else {
+		rtc->rtc_dev->ops = &aspeed_rtc_ops;
+	}
 	rtc->rtc_dev->range_min = RTC_TIMESTAMP_BEGIN_1900;
 	rtc->rtc_dev->range_max = 38814989399LL; /* 3199-12-31 23:59:59 */
 
 	return devm_rtc_register_device(rtc->rtc_dev);
 }
 
+static const struct aspeed_rtc_config config_bcd = { .counter_style = false };
+static const struct aspeed_rtc_config config_counter = { .counter_style = true };
+
 static const struct of_device_id aspeed_rtc_match[] = {
-	{ .compatible = "aspeed,ast2400-rtc", },
-	{ .compatible = "aspeed,ast2500-rtc", },
-	{ .compatible = "aspeed,ast2600-rtc", },
+	{ .compatible = "aspeed,ast2400-rtc", .data = &config_bcd },
+	{ .compatible = "aspeed,ast2500-rtc", .data = &config_bcd },
+	{ .compatible = "aspeed,ast2600-rtc", .data = &config_bcd },
+	{ .compatible = "aspeed,ast2050-rtc", .data = &config_counter },
 	{}
 };
 MODULE_DEVICE_TABLE(of, aspeed_rtc_match);
