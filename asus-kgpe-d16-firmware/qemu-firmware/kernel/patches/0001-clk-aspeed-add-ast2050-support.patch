 static const struct of_device_id aspeed_clk_dt_ids[] = {
 	{ .compatible = "aspeed,ast2400-scu", .data = &ast2400_data },
 	{ .compatible = "aspeed,ast2500-scu", .data = &ast2500_data },
+	{ .compatible = "aspeed,ast2050-scu", .data = &ast2050_data },
