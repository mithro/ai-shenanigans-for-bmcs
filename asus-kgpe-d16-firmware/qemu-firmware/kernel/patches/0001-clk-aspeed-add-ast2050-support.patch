+	}
 
-		/* Special case: the USB port 1 clock (bit 14) is always
-		 * working the opposite way from the other ones.
+	if (soc_data->is_ast2050) {
+		/*
+		 * G3: SCU0C[15] is ONE UARTCLK gate for both UARTs. The
+		 * aspeed-g4.dtsi serial nodes reference the per-UART G4 ids
+		 * (the console at 0x1E784000 uses ASPEED_CLK_GATE_UART5CLK),
+		 * so alias them all to the shared gate — the console's clk
+		 * reference then refcounts the REAL gate and
+		 * clk_disable_unused() can no longer kill a live console
+		 * (KGPE-D16 silicon finding #94).
 		 */
-		gate_flags = (gd->clock_idx == 14) ? 0 : CLK_GATE_SET_TO_DISABLE;
-		hw = aspeed_clk_hw_register_gate(dev,
-				gd->name,
-				gd->parent_name,
-				gd->flags,
-				map,
-				gd->clock_idx,
-				gd->reset_idx,
-				gate_flags,
-				&aspeed_clk_lock);
+		aspeed_clk_data->hws[ASPEED_CLK_GATE_UART2CLK] =
+			aspeed_clk_data->hws[ASPEED_CLK_GATE_UART1CLK];
+		aspeed_clk_data->hws[ASPEED_CLK_GATE_UART5CLK] =
+			aspeed_clk_data->hws[ASPEED_CLK_GATE_UART1CLK];
+
+		/*
+		 * G3: no MAC clock gates exist (SCU0C[31:20] reserved) — the
+		 * MAC clocks cannot be stopped. Provide ungateable
+		 * pass-throughs so the aspeed-g4.dtsi ftgmac100 references
+		 * resolve and enable/disable are no-ops.
+		 */
+		hw = clk_hw_register_fixed_factor(dev, "mac1clk-gate", "mac",
+						  0, 1, 1);
 		if (IS_ERR(hw))
 			return PTR_ERR(hw);
-		aspeed_clk_data->hws[i] = hw;
