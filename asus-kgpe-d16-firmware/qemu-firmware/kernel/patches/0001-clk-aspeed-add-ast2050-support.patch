+		hw = clk_hw_register_fixed_factor(dev, "mac2clk-gate", "mac",
+						  0, 1, 1);
+		if (IS_ERR(hw))
+			return PTR_ERR(hw);
+		aspeed_clk_data->hws[ASPEED_CLK_GATE_MAC2CLK] = hw;
 	}
 
