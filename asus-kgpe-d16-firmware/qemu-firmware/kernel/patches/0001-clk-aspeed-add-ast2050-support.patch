From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tim Ansell <me@mith.ro>
Date: Sat, 15 Feb 2026 00:00:00 +0000
Subject: [PATCH] clk: aspeed: Add AST2050/AST1100 clock support

The Aspeed AST2050 (also sold as AST1100) is an older BMC SoC that
shares the same ARM926EJ-S core and many peripherals with the AST2400,
but has incompatible clock register layouts.

PLL/strap differences from AST2400 (SCU24/SCU70):
  - H-PLL default frequency strap: SCU70 bits [11:9] (not [9:8])
    Values: 010=200MHz, 011=166MHz, 100=133MHz, 101=100MHz, 111=24MHz
  - CPU:AHB clock ratio: SCU70 bits [13:12] (not [11:10])
  - Input clock: always 24MHz (no 25MHz/48MHz options)
  - H-PLL post-divider: SCU24 bits [14:12] (not present on AST2400)
    Values: 0xx=div1, 100=div2, 101=div4, 110=div8, 111=div16

Clock-gate differences (SCU0C "Clock Stop Control", datasheet V1.05
p209-210) - the G3 gate map is NOT the AST2400 one:
  - bit15 is ONE "Stop UARTCLK" gate shared by BOTH UARTs (UART1
    @1E783000 + UART2 @1E784000, the console); bits 16/17 are reserved.
    With the AST2400 table, clk_disable_unused() stopped the shared
    gate as the "unused uart1clk-gate" while the console held the
    reserved no-op bit17 - killing the live serial console on the real
    ASUS KGPE-D16 at t=4.16s and, via blocked PID1 console writes,
    tripping the 120s aspeed WDT (silicon finding #94).
  - bits 31:20 are reserved: no MAC/RSA/UART3/UART4/SD/LHCLK gates.
    MAC clocks are exposed as ungateable fixed-factor pass-throughs.
  - bit7 = USB1.1 UCLK, bit14 = USB2.0 device clock enable (inverted),
    bit19 = BHCLK (PCI host, unused/not registered).
  - BCLK (bit4, PCI slave) and DCLK (bit5, VGA) stay CLK_IS_CRITICAL:
    they clock the VGA/P2A BAR recovery path and have no consumer.

SCU08 field-layout differences guarded by soc_data->is_ast2050:
  - no SD clock fields ([15:11] reserved), no MAC clock divider
    ([18:17] reserved; MACs run on AHB), LHCLK divider at [31:29]
    (not [22:20]), NO ECLK divider ([30:28] belong to LHCLK - a G4-
    style eclk divider write would clobber the LPC host clock), and
    no SCU D8 (the G3 SCU register file ends at 0x7C).

The single G3 UART gate is aliased to the ASPEED_CLK_GATE_UART1CLK/
UART2CLK/UART5CLK dt ids so unmodified aspeed-g4.dtsi serial nodes
refcount the real gate.

This patch adds:
  - aspeed_ast2050_calc_pll() with post-divider support
  - aspeed_ast2050_cc() with correct SCU70 bit positions
  - ast2050_gates[] G3 gate table + soc_data .gates/.num_gates/
    .is_ast2050 plumbing (NULL-name entries are gates absent on the
    SoC and are skipped)
  - "aspeed,ast2050-scu" compatible string in both the platform driver
    match table and CLK_OF_DECLARE_DRIVER early init

Tested on the ASUS KGPE-D16 (AST2050 A3) QEMU model and silicon; also
targets the Dell PowerEdge C410X (AST2050 BMC, ARM926EJ-S @ 200MHz).

Signed-off-by: Tim Ansell <me@mith.ro>
---
 drivers/clk/clk-aspeed.c | 330 ++++++++++++++++++++++++++++++++-----
 drivers/clk/clk-aspeed.h |  10 ++
 2 files changed, 294 insertions(+), 46 deletions(-)

diff --git a/drivers/clk/clk-aspeed.c b/drivers/clk/clk-aspeed.c
index ff84191d0..3e7342f67 100644
--- a/drivers/clk/clk-aspeed.c
+++ b/drivers/clk/clk-aspeed.c
@@ -146,6 +146,43 @@ static struct clk_hw *aspeed_ast2400_calc_pll(const char *name, u32 val)
 			mult, div);
 };
 
+static struct clk_hw *aspeed_ast2050_calc_pll(const char *name, u32 val)
+{
+	unsigned int mult, div;
+
+	if (val & AST2400_HPLL_BYPASS_EN) {
+		/* Pass through mode */
+		mult = div = 1;
+	} else {
+		/*
+		 * AST2050 H-PLL formula (same base as AST2400):
+		 *   F = 24MHz * (2-OD) * [(N+2) / (D+1)] / post_div
+		 *
+		 * OD      = bit [4]
+		 * N       = bits [10:5]
+		 * D       = bits [3:0]
+		 * PostDiv = bits [14:12]:
+		 *   0xx = /1, 100 = /2, 101 = /4, 110 = /8, 111 = /16
+		 */
+		u32 n = (val >> 5) & 0x3f;
+		u32 od = (val >> 4) & 0x1;
+		u32 d = val & 0xf;
+		u32 post = (val >> 12) & 0x7;
+		u32 post_div;
+
+		if (post < 4)
+			post_div = 1;
+		else
+			post_div = 1 << (post - 3); /* 4->2, 5->4, 6->8, 7->16 */
+
+		mult = (2 - od) * (n + 2);
+		div = (d + 1) * post_div;
+	}
+
+	return clk_hw_register_fixed_factor(NULL, name, "clkin", 0,
+			mult, div);
+};
+
 static struct clk_hw *aspeed_ast2500_calc_pll(const char *name, u32 val)
 {
 	unsigned int mult, div;
@@ -174,6 +211,57 @@ static const struct aspeed_clk_soc_data ast2500_data = {
 	.calc_pll = aspeed_ast2500_calc_pll,
 };
 
+/*
+ * AST2050/AST1100 (G3) SCU0C Clock Stop Control gate map (datasheet §18
+ * p209-210). This is NOT the AST2400 map:
+ *
+ *  - bit15 is ONE "Stop UARTCLK" gate shared by BOTH UARTs (UART1 @1E783000
+ *    and UART2 @1E784000, the serial console). Bits 16/17 (the G4 UART2/UART5
+ *    gates) are reserved on the G3. Registering the G4 table here made
+ *    clk_disable_unused() stop the shared gate as the "unused uart1clk-gate"
+ *    while the console held the reserved no-op bit17 — killing the live
+ *    console on real silicon at t=4.16s and (via blocked PID1 console writes)
+ *    tripping the 120 s aspeed WDT (KGPE-D16 finding #94).
+ *  - bits 31:20 are reserved: there are NO MAC/RSA/UART3/UART4/SD/LHCLK
+ *    gates. MAC clocks are exposed as ungateable pass-throughs in probe so
+ *    the aspeed-g4.dtsi references still resolve.
+ *  - bit7 is USB1.1 UCLK (not the G4 USB2-port2), bit14 is the USB2.0 device
+ *    clock enable (inverted polarity, same as G4 bit14), bit19 is BHCLK (PCI
+ *    host; unused, left at its stopped reset default by not registering it).
+ *  - BCLK (bit4, PCI slave) and DCLK (bit5, VGA) are kept CRITICAL: they
+ *    clock the VGA/P2A BAR path — the only recovery access to the BMC — and
+ *    have no Linux consumer to refcount them.
+ *
+ * Reset bits are the G3 SCU04 (§18 p205): Video=6, LPC=5, HAC=4, USB2.0=14.
+ * Table indices are the dt-binding clock ids; holes (NULL name) are gates
+ * that do not exist on the G3 and are skipped at registration.
+ */
+static const struct aspeed_gate_data ast2050_gates[] = {
+	/*				 clk rst   name		 parent	 flags */
+	[ASPEED_CLK_GATE_ECLK] =	{  0,  6, "eclk-gate",	 "eclk", 0 }, /* Video Engine */
+	[ASPEED_CLK_GATE_GCLK] =	{  1, -1, "gclk-gate",	 NULL,	 0 }, /* 2D engine */
+	[ASPEED_CLK_GATE_MCLK] =	{  2, -1, "mclk-gate",	 "mpll", CLK_IS_CRITICAL }, /* SDRAM */
+	[ASPEED_CLK_GATE_VCLK] =	{  3, -1, "vclk-gate",	 NULL,	 0 }, /* Video Capture */
+	[ASPEED_CLK_GATE_BCLK] =	{  4, -1, "bclk-gate",	 "bclk", CLK_IS_CRITICAL }, /* PCI slave / P2A */
+	[ASPEED_CLK_GATE_DCLK] =	{  5, -1, "dclk-gate",	 NULL,	 CLK_IS_CRITICAL }, /* VGA DAC */
+	[ASPEED_CLK_GATE_REFCLK] =	{  6, -1, "refclk-gate", "clkin", CLK_IS_CRITICAL },
+	[ASPEED_CLK_GATE_USBUHCICLK] =	{  7, -1, "uclk-gate",	 NULL,	 0 }, /* USB1.1 */
+	[ASPEED_CLK_GATE_LCLK] =	{  8,  5, "lclk-gate",	 NULL,	 0 }, /* LPC (KCS/BT/snoop) */
+	[ASPEED_CLK_GATE_YCLK] =	{ 13,  4, "yclk-gate",	 NULL,	 0 }, /* HAC */
+	[ASPEED_CLK_GATE_USBPORT1CLK] = { 14, 14, "usb2clk-gate", NULL,	 0 }, /* USB2.0 device/vhub (inverted) */
+	[ASPEED_CLK_GATE_UART1CLK] =	{ 15, -1, "uartclk-gate", "uart", 0 }, /* UART1+UART2 SHARED */
+};
+
+static const struct aspeed_clk_soc_data ast2050_data = {
+	.div_table = ast2400_div_table,
+	.eclk_div_table = ast2400_div_table,
+	.mac_div_table = ast2400_div_table,
+	.gates = ast2050_gates,
+	.num_gates = ARRAY_SIZE(ast2050_gates),
+	.is_ast2050 = true,
+	.calc_pll = aspeed_ast2050_calc_pll,
+};
+
 static const struct aspeed_clk_soc_data ast2400_data = {
 	.div_table = ast2400_div_table,
 	.eclk_div_table = ast2400_div_table,
@@ -440,25 +528,39 @@ static int aspeed_clk_probe(struct platform_device *pdev)
 		return PTR_ERR(hw);
 	aspeed_clk_data->hws[ASPEED_CLK_MPLL] =	hw;
 
-	/* SD/SDIO clock divider and gate */
-	hw = clk_hw_register_gate(dev, "sd_extclk_gate", "hpll", 0,
-				  scu_base + ASPEED_CLK_SELECTION, 15, 0,
-				  &aspeed_clk_lock);
-	if (IS_ERR(hw))
-		return PTR_ERR(hw);
-	hw = clk_hw_register_divider_table(dev, "sd_extclk", "sd_extclk_gate",
-			0, scu_base + ASPEED_CLK_SELECTION, 12, 3, 0,
-			soc_data->div_table,
-			&aspeed_clk_lock);
-	if (IS_ERR(hw))
-		return PTR_ERR(hw);
-	aspeed_clk_data->hws[ASPEED_CLK_SDIO] = hw;
+	/*
+	 * SD/SDIO clock divider and gate. The AST2050 (G3) has no SD host and
+	 * SCU08[15:11] are reserved-keep-0 there — do not register (and never
+	 * touch) these fields on the G3.
+	 */
+	if (!soc_data->is_ast2050) {
+		hw = clk_hw_register_gate(dev, "sd_extclk_gate", "hpll", 0,
+					  scu_base + ASPEED_CLK_SELECTION, 15, 0,
+					  &aspeed_clk_lock);
+		if (IS_ERR(hw))
+			return PTR_ERR(hw);
+		hw = clk_hw_register_divider_table(dev, "sd_extclk",
+				"sd_extclk_gate",
+				0, scu_base + ASPEED_CLK_SELECTION, 12, 3, 0,
+				soc_data->div_table,
+				&aspeed_clk_lock);
+		if (IS_ERR(hw))
+			return PTR_ERR(hw);
+		aspeed_clk_data->hws[ASPEED_CLK_SDIO] = hw;
+	}
 
-	/* MAC AHB bus clock divider */
-	hw = clk_hw_register_divider_table(dev, "mac", "hpll", 0,
-			scu_base + ASPEED_CLK_SELECTION, 16, 3, 0,
-			soc_data->mac_div_table,
-			&aspeed_clk_lock);
+	/*
+	 * MAC AHB bus clock divider. On the AST2050 (G3) there is no MAC
+	 * divider in SCU08 (bits [18:17] are reserved, [16] is an RTC test
+	 * bit); the MACs run on the AHB clock directly.
+	 */
+	if (soc_data->is_ast2050)
+		hw = clk_hw_register_fixed_factor(dev, "mac", "ahb", 0, 1, 1);
+	else
+		hw = clk_hw_register_divider_table(dev, "mac", "hpll", 0,
+				scu_base + ASPEED_CLK_SELECTION, 16, 3, 0,
+				soc_data->mac_div_table,
+				&aspeed_clk_lock);
 	if (IS_ERR(hw))
 		return PTR_ERR(hw);
 	aspeed_clk_data->hws[ASPEED_CLK_MAC] = hw;
@@ -487,20 +589,32 @@ static int aspeed_clk_probe(struct platform_device *pdev)
 		aspeed_clk_data->hws[ASPEED_CLK_MAC2RCLK] = hw;
 	}
 
-	/* LPC Host (LHCLK) clock divider */
+	/*
+	 * LPC Host (LHCLK) clock divider. G3: the field is SCU08[31:29]
+	 * (SCU08[22:20] is the PCI-host BHCLK divider there).
+	 */
 	hw = clk_hw_register_divider_table(dev, "lhclk", "hpll", 0,
-			scu_base + ASPEED_CLK_SELECTION, 20, 3, 0,
+			scu_base + ASPEED_CLK_SELECTION,
+			soc_data->is_ast2050 ? 29 : 20, 3, 0,
 			soc_data->div_table,
 			&aspeed_clk_lock);
 	if (IS_ERR(hw))
 		return PTR_ERR(hw);
 	aspeed_clk_data->hws[ASPEED_CLK_LHCLK] = hw;
 
-	/* P-Bus (BCLK) clock divider */
-	hw = clk_hw_register_divider_table(dev, "bclk", "hpll", 0,
-			scu_base + ASPEED_CLK_SELECTION_2, 0, 2, 0,
-			soc_data->div_table,
-			&aspeed_clk_lock);
+	/*
+	 * P-Bus (BCLK) clock divider. The G3 has no SCU D8 register (its SCU
+	 * file ends at 0x7C); the PCI-slave BCLK is the 33 MHz PCI clock.
+	 * Never dereference SCU D8 on the G3.
+	 */
+	if (soc_data->is_ast2050)
+		hw = clk_hw_register_fixed_rate(dev, "bclk", NULL, 0,
+						33333333);
+	else
+		hw = clk_hw_register_divider_table(dev, "bclk", "hpll", 0,
+				scu_base + ASPEED_CLK_SELECTION_2, 0, 2, 0,
+				soc_data->div_table,
+				&aspeed_clk_lock);
 	if (IS_ERR(hw))
 		return PTR_ERR(hw);
 	aspeed_clk_data->hws[ASPEED_CLK_BCLK] = hw;
@@ -520,7 +634,17 @@ static int aspeed_clk_probe(struct platform_device *pdev)
 		return PTR_ERR(hw);
 	aspeed_clk_data->hws[ASPEED_CLK_ECLK_MUX] = hw;
 
-	hw = clk_hw_register_divider_table(dev, "eclk", "eclk-mux", 0,
+	/*
+	 * ECLK divider. The G3 has NO ECLK divider — the video engine clock is
+	 * the selected PLL directly, and SCU08[30:28] belong to the LHCLK
+	 * divider/enable there (writing a G4-style eclk divider would clobber
+	 * the G3 LPC-host clock setting).
+	 */
+	if (soc_data->is_ast2050)
+		hw = clk_hw_register_fixed_factor(dev, "eclk", "eclk-mux", 0,
+						  1, 1);
+	else
+		hw = clk_hw_register_divider_table(dev, "eclk", "eclk-mux", 0,
 					   scu_base + ASPEED_CLK_SELECTION, 28,
 					   3, 0, soc_data->eclk_div_table,
 					   &aspeed_clk_lock);
@@ -539,26 +663,72 @@ static int aspeed_clk_probe(struct platform_device *pdev)
 	 *   UART[1..5] clock source mux
 	 */
 
-	for (i = 0; i < ARRAY_SIZE(aspeed_gates); i++) {
-		const struct aspeed_gate_data *gd = &aspeed_gates[i];
-		u32 gate_flags;
+	{
+		const struct aspeed_gate_data *gates = soc_data->gates ?
+			soc_data->gates : aspeed_gates;
+		int num_gates = soc_data->gates ? soc_data->num_gates :
+			ARRAY_SIZE(aspeed_gates);
+
+		for (i = 0; i < num_gates; i++) {
+			const struct aspeed_gate_data *gd = &gates[i];
+			u32 gate_flags;
+
+			/* A hole in a SoC-specific table: no such gate here */
+			if (!gd->name)
+				continue;
+
+			/* Special case: the USB port 1 clock (bit 14) is
+			 * always working the opposite way from the other
+			 * ones.
+			 */
+			gate_flags = (gd->clock_idx == 14) ?
+				0 : CLK_GATE_SET_TO_DISABLE;
+			hw = aspeed_clk_hw_register_gate(dev,
+					gd->name,
+					gd->parent_name,
+					gd->flags,
+					map,
+					gd->clock_idx,
+					gd->reset_idx,
+					gate_flags,
+					&aspeed_clk_lock);
+			if (IS_ERR(hw))
+				return PTR_ERR(hw);
+			aspeed_clk_data->hws[i] = hw;
