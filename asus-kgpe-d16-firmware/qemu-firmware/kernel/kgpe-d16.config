# ASUS KGPE-D16 BMC (AST2050) kernel config fragment.
# Merged onto `aspeed_g4_defconfig` with scripts/kconfig/merge_config.sh.
# Goal: a small kernel that boots on the kgpe-d16-bmc QEMU machine to an
# initramfs shell and supports SSH over the QEMU user-net NIC.

# --- Networking (SSH over QEMU user-net via the FTGMAC100 NIC) ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_FTGMAC100=y

# --- initramfs as root ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Serial console (AST2050 UART2 @ 0x1e784000 == aspeed uart5/ttyS4) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- I2C: dual-socket server sensors (DIMM SPD, CPU/board temps, PSU) ---
CONFIG_I2C=y
CONFIG_I2C_ASPEED=y
CONFIG_SENSORS_LM75=y

# --- DIMM SPD/TSOD behind the QU9/QU5/U23 mux fabric (D08) ---
# GPIOF4/F5 select the QU5 channel (schematic-wiring/I2C-MUX-FABRIC-
# ARBITRATION.md); i2c-mux-gpio drives them per the /i2cmux DTS node. SPD
# EEPROMs bind at24 (256-byte 24c02-class), the TS-on-DIMM sensors bind jc42.
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_GPIO=y
CONFIG_EEPROM_AT24=y
CONFIG_SENSORS_JC42=y

# --- Hardware monitor: Nuvoton/Winbond W83795G on BMC I2C bus 1 @ 0x2f ---
# The KGPE-D16's sole fan/voltage/temperature chip (8 fan-tach + 8 PWM, dual
# Vcore, rails, CPU thermal diode + 2 AMD SB-TSI DTS die temps). Modelled in the
# kgpe-d16-bmc QEMU machine (hw/sensor/w83795.c) and present on the real board.
# FANCTRL adds the PWM/fan-control sysfs the driver exposes for the w83795g.
CONFIG_SENSORS_W83795=y
CONFIG_SENSORS_W83795_FANCTRL=y

# --- NC-SI: BMC channel-2 sideband to the two Intel 82574L host NICs (D07) ---
# Schematic §7: the AST2050's MAC2 (RMII2, 0x1e680000) is a multi-drop NC-SI
# sideband to LU1/LU2 (82574L, on +3V3_AUX). SCU70[8:6]=110 strap-enables it
# on the real board (measured SCU70=0x00819582). net/ncsi drives it via the
# ftgmac100 mac1 node's `use-ncsi`. The Intel OEM commands (mfr 0x157) — Get
# System MAC Address (0x06) and keep-PHY (0x20) — are the 82574L's, per its
# datasheet; enable them so a shared-MAC/critical-session setup works.
CONFIG_NET_NCSI=y
CONFIG_NCSI_OEM_CMD_GET_MAC=y
CONFIG_NCSI_OEM_CMD_KEEP_PHY=y

# --- Watchdog (AST2050 WDT) ---
CONFIG_ASPEED_WATCHDOG=y

# --- Host-side IPMI over LPC KCS (F5b: local host<->BMC channel) ---
# aspeed_g4_defconfig already sets CONFIG_IPMI_KCS_BMC + CONFIG_ASPEED_KCS_IPMI_BMC
# (the KCS BMC core + the aspeed LPC KCS driver), but NOT the char-device client
# that creates /dev/ipmi-kcs<N>. Without CDEV_IPMI the KCS channel registers with
# the core but exposes no /dev node, so OpenBMC's kcsbridge/phosphor-ipmi-host has
# nothing to open. Enable the cdev-ipmi client so the &lpc/kcs@2c node yields
# /dev/ipmi-kcs3. (BT is intentionally not enabled: mainline's ibt/bt-bmc driver
# uses the AST2400 0x140 offset, wrong for the G3 whose BT block is at 0x48-0x68.)
CONFIG_IPMI_KCS_BMC=y
CONFIG_IPMI_KCS_BMC_CDEV_IPMI=y
CONFIG_ASPEED_KCS_IPMI_BMC=y

# --- Size: the BMC has limited RAM ---
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# --- Headless BMC: no graphics/USB/MMC/wireless ---
CONFIG_DRM=n
CONFIG_USB_SUPPORT=n
CONFIG_MMC=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
