# ASUS KGPE-D16 BMC (AST2050) — USB (F6) kernel config fragment.
# Merged onto aspeed_g4_defconfig + kgpe-d16.config LAST, so it re-enables the USB
# support that kgpe-d16.config turns off (CONFIG_USB_SUPPORT=n).
#
# FAITHFULNESS (datasheet-grounded): the AST2050 has exactly ONE USB block — the
# USB2.0 *device / virtual-hub* controller at 0x1E6A0000 (VIC INT#5). It has NO USB
# *host* controller (no EHCI/UHCI/OHCI); the §9 memory map (p.97) lists a single
# "USB2.0 Controller" region and §15 documents only a device/vhub. So the BMC's
# "connect USB devices" capability is the USB *gadget* path (present virtual
# keyboard/mouse/mass-storage TO THE HOST during KVM), not a USB host stack. This
# fragment therefore enables the gadget stack, not a host stack.
# See asus-kgpe-d16-firmware/openbmc/bmc-functionality/F6-USB.md.

# --- USB core (needed by the gadget framework + the dummy host used for the demo) ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y

# --- USB gadget framework ---
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y

# --- Faithful AST2050 USB2.0 device/vhub driver ---
# aspeed-vhub is the mainline Aspeed virtual-hub UDC driver. It is an AST2400-family
# driver; the AST2050 vhub register file differs (7 downstream ports + 21-EP pool vs
# the AST2400's 5/15), but it is the correct *class* of controller and binds at the
# AST2050 USB base (0x1E6A0000, IRQ5) via the DTS &vhub node with the faithful G3
# port/EP counts. A dedicated G3 UDC driver is future faithfulness work (F8-KVM).
CONFIG_USB_ASPEED_VHUB=y

# --- dummy_hcd: software UDC + host loopback, used to demonstrate the gadget stack
#     enumerating a device IN-GUEST without any external USB host (the real AST2050
#     device/vhub presents to the *server host*, which QEMU does not emulate). This
#     is groundwork the F8 KVM work runs over the real vhub UDC. ---
CONFIG_USB_DUMMY_HCD=y

# --- configfs gadgets: build a mass-storage (virtual media) + HID (virtual kbd/mouse)
#     gadget at runtime and bind it to a UDC. HID + mass-storage are exactly the
#     vKVM / virtual-media functions F8 needs. ---
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_HID=y
