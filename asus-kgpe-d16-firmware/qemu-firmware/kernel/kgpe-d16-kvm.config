# ASUS KGPE-D16 BMC (AST2050) — KVM-over-IP (F8) kernel config fragment.
# Merged onto aspeed_g4_defconfig + kgpe-d16.config + kgpe-d16-usb.config LAST.
#
# KVM-over-IP on this BMC is three cooperating blocks (see F8-KVM.md):
#   1. VIDEO ENGINE  (0x1E700000, VIC INT#7) — captures the host VGA framebuffer.
#      Driven by the mainline aspeed-video V4L2 driver -> /dev/video0.
#   2. USB2.0 vhub   (0x1E6A0000, VIC INT#5) — presents a virtual HID keyboard +
#      mouse to the server host. The gadget stack + f_hid come from
#      kgpe-d16-usb.config (F6); this fragment adds the HOST-side HID + input
#      layers so the in-guest dummy_hcd loopback that stands in for the real
#      server host can bind the gadget and deliver the keypress to an evdev node.
#   3. obmc-ikvm     — userspace (assessed for the 64 MB image in F8-KVM.md §4).
#
# FAITHFULNESS: the AST2050 video engine is an AST2050-only block (datasheet
# §1.3.6 p.19, §20 p.232). The mainline aspeed-video driver targets the
# AST2400/2500/2600 register layout, which differs from the G3 (DATASHEET-VIDEO.md
# §7); it binds via the aspeed-g4.dtsi "aspeed,ast2400-video-engine" node and
# registers /dev/video0, but real capture (VR004 trigger -> JPEG) is deferred in
# the QEMU model. See F8-KVM.md.

# --- V4L2 / media core (needed by aspeed-video) ---
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_V4L2=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y

# --- AST2050 video engine (KVM screen capture) ---
# Mainline drivers/media/platform/aspeed/aspeed-video.c. Binds the aspeed-g4.dtsi
# video@1e700000 node (compatible aspeed,ast2400-video-engine, INT#7, VCLK+ECLK)
# enabled in the KGPE-D16 DTS, and exposes /dev/video0.
CONFIG_VIDEO_ASPEED=y

# --- HOST-side HID (so the in-guest dummy_hcd host end binds the gadget kbd/mouse
#     and turns a report into an input event we can observe). The gadget side
#     (f_hid -> /dev/hidg0) is enabled by kgpe-d16-usb.config. ---
CONFIG_HID=y
CONFIG_HID_SUPPORT=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
