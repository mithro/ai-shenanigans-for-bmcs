# Swap support for the memory-tight AST2050 BMC (64 MB DDR2, minus the 8 MB VGA
# reserved-memory fence = ~44 MB usable). aspeed_g4_defconfig ships with
# CONFIG_SWAP unset, so no swap of any kind works. Enabling it lets the BMC use
# a swap device to gain headroom for the full daemon set (bmcweb + sensors that
# don't otherwise fit 64 MB).
#
# Primary path: swap over NBD (network block device) to a RAM-backed export on
# the Pi bridge (192.168.66.1) — NBD is already CONFIG_BLK_DEV_NBD=y and its
# swap-over-network deadlock avoidance (SOCK_MEMALLOC + PF_MEMALLOC) is the
# mainline "swap over NBD" support, so it works under memory pressure. This
# offloads cold pages entirely to the Pi's abundant RAM rather than consuming the
# BMC's own scarce RAM.
CONFIG_SWAP=y

# zram (compressed RAM swap) as a self-contained fallback that needs no network.
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZO=y
