// SPDX-License-Identifier: GPL-2.0+
/dts-v1/;

#include "aspeed-g4.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>
#include <dt-bindings/input/input.h>

/*
 * ASUS KGPE-D16 server-board BMC.
 *
 * The BMC SoC is an ASPEED AST2050 (G3 generation, ARM926EJ-S). It is
 * register-compatible with the AST2400 (G4) for the blocks we use, so this
 * device tree is built on aspeed-g4.dtsi and only overrides the SCU compatible
 * so the AST2050 clock driver matches (see kernel/patches/0001-clk-aspeed-...).
 *
 * Targets the `kgpe-d16-bmc` QEMU machine: console on UART5 (0x1e784000, the
 * AST2050's "UART2"), 64 MB DDR2, one FTGMAC100 NIC.
 */

/ {
	model = "ASUS KGPE-D16 BMC";
	compatible = "asus,kgpe-d16-bmc", "aspeed,ast2400";

	aliases {
		serial4 = &uart5;
	};

	chosen {
		stdout-path = &uart5;
		bootargs = "console=ttyS4,115200n8 earlyprintk";
	};

	memory@40000000 {
		device_type = "memory";
		/*
		 * 64 MB DDR2, hardware-verified on the real KGPE-D16 BMC
		 * (2026-07-08, culvert P2A: real size aliases mod 64 MB; the
		 * chip is 4-bank/64 MB, MCR04=0x00000585). See ast2050.h
		 * PHYS_SDRAM_1_SIZE and RAPTOR_ENGINEERING_AST2050_ANALYSIS.md.
		 */
		reg = <0x40000000 0x04000000>;	/* 64 MB */
	};

	/*
	 * Host power-control LEDs (F2). Active-low, per Raptor's board GPIO CSV
	 * (HW-WIRING-power-sensors.md §1.1/§1.3). Only the board-authoritative
	 * LEDs are listed (the Facebook-Wedge power_led/post_led leftovers are
	 * deliberately ignored).
	 */
	leds {
		compatible = "gpio-leds";

		led-bmc-status {
			label = "bmc-status";
			gpios = <&gpio ASPEED_GPIO(E, 1) GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
		};

		led-identify {
			label = "identify";
			gpios = <&gpio ASPEED_GPIO(G, 0) GPIO_ACTIVE_LOW>;
		};

		led-cpu1-error {
			label = "cpu1-error";
			gpios = <&gpio ASPEED_GPIO(E, 3) GPIO_ACTIVE_LOW>;
		};

		led-cpu2-error {
			label = "cpu2-error";
			gpios = <&gpio ASPEED_GPIO(E, 2) GPIO_ACTIVE_LOW>;
		};
	};

	/* Front-panel locator / ID button (GPIOG1, active low). */
	gpio-keys {
		compatible = "gpio-keys";

		id-button {
			label = "id-button";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio ASPEED_GPIO(G, 1) GPIO_ACTIVE_LOW>;
		};
	};
};

&gpio {
	status = "okay";
	/*
	 * Host power control (F2). gpio-line-names is POSITIONAL: entry N names
	 * line N = bank*8 + pin (A0=0, B0=8, ... H0=56). The 12 board-meaningful
	 * lines (from Raptor's asus-BMC-GPIO.csv, HW-WIRING-power-sensors.md §1.1)
	 * are the active-low power-request lines the BMC drives (power-up-req-n
	 * B1, power-down-req-n F0, reset-req-n B6), the power-state-in input
	 * (power-state-in H2, 1=on), the BMC-control lockout (A4), the SPD-mux
	 * selects (F4/F5), the LEDs (E1/E2/E3/G0) and the ID switch (G1). These
	 * names are what phosphor-gpio / libgpiod resolve against; the modeled
	 * QEMU power-sequencer (aspeed_gpio_kgpe_d16_pwrseq) latches B1/F0/B6 and
	 * feeds H2 back so the whole OpenBMC power path is demonstrable.
	 */
	gpio-line-names =
		/*  A0..A7 */ "", "", "", "", "bmc-ctl-lockout-n", "", "", "",
		/*  B0..B7 */ "", "power-up-req-n", "", "", "", "", "reset-req-n", "",
		/*  C0..C7 */ "", "", "", "", "", "", "", "",
		/*  D0..D7 */ "", "", "", "", "", "", "", "",
		/*  E0..E7 */ "", "led-bmc-status-n", "led-cpu2-err-n", "led-cpu1-err-n", "", "", "", "",
		/*  F0..F7 */ "power-down-req-n", "", "", "", "spd-mux-s1", "spd-mux-s0", "", "",
		/*  G0..G7 */ "led-id-n", "sw-id-n", "", "", "", "", "", "",
		/*  H0..H2 */ "", "", "power-state-in";
};

&syscon {
	/* AST2050 clock driver matches first, AST2400 for everything else. */
	compatible = "aspeed,ast2050-scu", "aspeed,ast2400-scu",
		     "syscon", "simple-mfd";
};

&vic {
	/*
	 * AST2050 (G3) compact VIC: a single 32-bit bank at 0x1e6c0000, register
	 * window 0x00-0x38 (NOT the AST2400 two-bank layout at 0x1e6c0080). Bound
	 * by irq-aspeed-g3-vic, which programs the trigger config (SENSE/DUAL/
	 * EVENT) the AST2400 hardwires. See qemu-model/peripherals/vic.
	 *
	 * Now wired: the QEMU AST2050 SoC uses TYPE_ASPEED_2050_VIC and the C410X
	 * vendor firmware (C4 oracle) boots on it, once the faithful timer emits one
	 * rising-edge pulse per expiry (aspeed_timer.c) instead of toggling — the
	 * toggle only delivered every other expiry under the G3's single-edge config,
	 * halving the guest clock and tripping the vendor watchdog. See
	 * qemu-model/results/vic-hardware-crosscheck.md.
	 */
	compatible = "aspeed,ast2050-vic";
	reg = <0x1e6c0000 0x40>;
};

&uart5 {
	status = "okay";
};

/*
 * Host-facing VUART (0x1e787000) — the AST2050 (G3) Virtual UART the x86 host
 * reaches over LPC (I/O 0x3F8, SIRQ 4; datasheet §29). It is the Serial-over-LAN
 * source: obmc-console-server binds it as /dev/ttyVUART0 (udev rule keyed on
 * iomem_base 0x1E787000) and netipmid exposes it via `ipmitool sol activate`.
 * Raptor's real AST2050 OpenBMC port uses this same block (dev-vuart.c ->
 * mainline 8250_aspeed_vuart.c). The kgpe-d16-bmc QEMU machine models it as a
 * 16550 wired to serial_hd(1). The driver defaults lpc-io-reg=0x3f8 / sirq=4
 * (COM1), which match this board.
 */
&vuart {
	status = "okay";
};

/*
 * Host-side IPMI over LPC KCS (F5b — local host<->BMC channel). The AST2050 (G3)
 * LPC controller at 0x1e789000 exposes three H8S/2168-style KCS channels; each is
 * an IDRn/ODRn/STRn register triple (datasheet §30.3, p.315; DATASHEET-LPC.md):
 *   ch1 0x24/0x30/0x3c   ch2 0x28/0x34/0x40   ch3 0x2c/0x38/0x44
 * These offsets are IDENTICAL on the AST2400, so mainline kcs_bmc_aspeed binds
 * unchanged: drivers/char/ipmi/kcs_bmc_aspeed.c defines LPC_IDR1=0x024 ...
 * LPC_STR3=0x044, exactly matching the datasheet. The faithful QEMU G3 LPC model
 * (qemu/hw/misc/aspeed_lpc_ast2050.c) services these registers (RW config/data,
 * read-only KCS status STR1-3). NB: BT is NOT wired here — on the G3 the BT block
 * is at 0x48-0x68 (H8S layout), but mainline's aspeed,ast2400-ibt-bmc / bt-bmc.c
 * hardcode the AST2400 0x140 offset, which is beyond this SoC's LPC register file
 * (model window 0x00-0x9F) and unimplemented on real AST2050 silicon — so KCS is
 * the only mainline-drivable host-IPMI channel on this SoC. See HOST-KCS-BT-STATUS.md.
 *
 * Channel 3 is the classic IPMI SMS "system interface": host I/O port 0xca2 (data
 * 0xca2 / status+command 0xca3), the OpenBMC convention. The kernel binds
 * kcs_bmc_aspeed + the cdev-ipmi client (CONFIG_IPMI_KCS_BMC_CDEV_IPMI) and creates
 * /dev/ipmi-kcs3, which OpenBMC's host-IPMI bridge (phosphor-ipmi-kcs / kcsbridge)
 * opens to feed ipmid. LPC IRQ = VIC #8 (datasheet §10 Table 36, p.99; SoC memmap
 * ASPEED_DEV_LPC=8), the host->BMC IBF completion.
 */
&lpc {
	kcs3: kcs@2c {
		compatible = "aspeed,ast2400-kcs-bmc-v2";
		reg = <0x2c 0x1>, <0x38 0x1>, <0x44 0x1>;
		aspeed,lpc-io-reg = <0xca2>;
		interrupts = <8>;
		status = "okay";
	};
};

&mac0 {
	status = "okay";
	/*
	 * AST2050 (G3) MAC, register-compatible with the AST2400. phy-mode=rmii
	 * with the real RTL8201CP PHY (no fixed-link) -- matching the real board.
	 * The eth0 RX=0 bug is NOT a PHY/RMII issue: on the G3 a MAC SW_RST clears
	 * the MACCR speed bit, and the mainline driver's preserve-only start_hw()
	 * leaves the MAC in 10M timing on the 100M link -> rx=0. The kgpe-d16-bmc
	 * QEMU MAC models that; the kernel cur_speed patch fixes it. The fix is
	 * FAST_MODE alone -- it does not depend on this DTS, which is why no
	 * fixed-link workaround is needed here.
	 */
	phy-mode = "rmii";
};

&i2c1 {
	status = "okay";

	/*
	 * Nuvoton/Winbond W83795G hardware monitor -- the KGPE-D16's single
	 * fan/voltage/temperature sensor chip, on the BMC's I2C bus 1 at 0x2f
	 * (Raptor's AST2050 OpenBMC port taps it exactly there; coreboot's
	 * devicetree.cb programs its channel map). The AST2050's own PWM/tach
	 * block is unused on this board -- all sensors come from this chip.
	 *
	 * The mainline drivers/hwmon/w83795.c has no of_match_table, but the I2C
	 * core's DT modalias fallback strips the "winbond," vendor prefix and
	 * matches the driver's i2c_device_id "w83795g", so this node binds and
	 * exposes /sys/bus/i2c/devices/1-002f/hwmon for phosphor-hwmon.
	 * Modelled in QEMU by hw/sensor/w83795.c on the kgpe-d16-bmc machine.
	 */
	hwmon@2f {
		compatible = "winbond,w83795g";
		reg = <0x2f>;
	};
};

&wdt1 {
	status = "okay";
};
