// SPDX-License-Identifier: GPL-2.0+
/dts-v1/;

#include "aspeed-g4.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>
#include <dt-bindings/input/input.h>

/*
 * ASUS KGPE-D16 server-board BMC.
 *
 * The BMC SoC is an ASPEED AST2050 (G3 generation, ARM926EJ-S). It is
 * register-compatible with the AST2400 (G4) for the blocks we use, so this
 * device tree is built on aspeed-g4.dtsi and only overrides the SCU compatible
 * so the AST2050 clock driver matches (see kernel/patches/0001-clk-aspeed-...).
 *
 * Targets the `kgpe-d16-bmc` QEMU machine: console on UART5 (0x1e784000, the
 * AST2050's "UART2"), 64 MB DDR2, one FTGMAC100 NIC.
 */

/ {
	model = "ASUS KGPE-D16 BMC";
	compatible = "asus,kgpe-d16-bmc", "aspeed,ast2400";

	aliases {
		serial4 = &uart5;
	};

	chosen {
		stdout-path = &uart5;
		bootargs = "console=ttyS4,115200n8 earlyprintk";
	};

	memory@40000000 {
		device_type = "memory";
		/*
		 * 64 MB DDR2, hardware-verified on the real KGPE-D16 BMC
		 * (2026-07-08, culvert P2A: real size aliases mod 64 MB; the
		 * chip is 4-bank/64 MB, MCR04=0x00000585). See ast2050.h
		 * PHYS_SDRAM_1_SIZE and RAPTOR_ENGINEERING_AST2050_ANALYSIS.md.
		 */
		reg = <0x40000000 0x04000000>;	/* 64 MB */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * VGA/graphics aperture: the AST2050's integrated VGA controller
		 * (the host's video adapter on the KGPE-D16) frame-buffers out of
		 * the top of BMC DRAM. Size is the SCU70[3:2] hardware strap
		 * (datasheet §18.2 p.217, mirrored into MCR04[5:4] §17 p.185) —
		 * hardware-verified 8 MB on this board: the live JTAG DDR2 init
		 * computed "MCR04 = 0x00000585" from the real SCU70 (bits [5:4] =
		 * 00 = 8 MB; JTAG-USAGE-GUIDE.md). no-map keeps the BMC kernel
		 * out of the host's framebuffer; the video engine (F8) captures
		 * from this region. Same pattern as the C410X vga_memory node and
		 * mainline aspeed boards.
		 */
		vga_memory: region@43800000 {
			no-map;
			compatible = "shared-dma-pool";
			reg = <0x43800000 0x00800000>;	/* 8 MB */
		};
	};

	/*
	 * Host power-control LEDs (F2). Active-low, per Raptor's board GPIO CSV
	 * (HW-WIRING-power-sensors.md §1.1/§1.3). Only the board-authoritative
	 * LEDs are listed (the Facebook-Wedge power_led/post_led leftovers are
	 * deliberately ignored).
	 */
	leds {
		compatible = "gpio-leds";

		led-bmc-status {
			label = "bmc-status";
			gpios = <&gpio ASPEED_GPIO(E, 1) GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
		};

		led-identify {
			label = "identify";
			gpios = <&gpio ASPEED_GPIO(G, 0) GPIO_ACTIVE_LOW>;
		};

		led-cpu1-error {
			label = "cpu1-error";
			gpios = <&gpio ASPEED_GPIO(E, 3) GPIO_ACTIVE_LOW>;
		};

		led-cpu2-error {
			label = "cpu2-error";
			gpios = <&gpio ASPEED_GPIO(E, 2) GPIO_ACTIVE_LOW>;
		};
	};

	/* Front-panel locator / ID button (GPIOG1, active low). */
	gpio-keys {
		compatible = "gpio-keys";

		id-button {
			label = "id-button";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio ASPEED_GPIO(G, 1) GPIO_ACTIVE_LOW>;
		};
	};
};

&gpio {
	status = "okay";
	/*
	 * Host power control (F2). gpio-line-names is POSITIONAL: entry N names
	 * line N = bank*8 + pin (A0=0, B0=8, ... H0=56). The 12 board-meaningful
	 * lines (from Raptor's asus-BMC-GPIO.csv, HW-WIRING-power-sensors.md §1.1)
	 * are the active-low power-request lines the BMC drives (power-up-req-n
	 * B1, power-down-req-n F0, reset-req-n B6), the power-state-in input
	 * (power-state-in H2, 1=on), the BMC-control lockout (A4), the SPD-mux
	 * selects (F4/F5), the LEDs (E1/E2/E3/G0) and the ID switch (G1). These
	 * names are what phosphor-gpio / libgpiod resolve against; the modeled
	 * QEMU power-sequencer (aspeed_gpio_kgpe_d16_pwrseq) latches B1/F0/B6 and
	 * feeds H2 back so the whole OpenBMC power path is demonstrable.
	 */
	gpio-line-names =
		/*  A0..A7 */ "", "", "", "", "bmc-ctl-lockout-n", "", "", "",
		/*  B0..B7 */ "", "power-up-req-n", "", "", "", "", "reset-req-n", "",
		/*  C0..C7 */ "", "", "", "", "", "", "", "",
		/*  D0..D7 */ "", "", "", "", "", "", "", "",
		/*  E0..E7 */ "", "led-bmc-status-n", "led-cpu2-err-n", "led-cpu1-err-n", "", "", "", "",
		/*  F0..F7 */ "power-down-req-n", "", "", "", "spd-mux-s1", "spd-mux-s0", "", "",
		/*  G0..G7 */ "led-id-n", "sw-id-n", "", "", "", "", "", "",
		/*  H0..H2 */ "", "", "power-state-in";
};

&syscon {
	/* AST2050 clock driver matches first, AST2400 for everything else. */
	compatible = "aspeed,ast2050-scu", "aspeed,ast2400-scu",
		     "syscon", "simple-mfd";
};

&vic {
	/*
	 * AST2050 (G3) compact VIC: a single 32-bit bank at 0x1e6c0000, register
	 * window 0x00-0x38 (NOT the AST2400 two-bank layout at 0x1e6c0080). Bound
	 * by irq-aspeed-g3-vic, which programs the trigger config (SENSE/DUAL/
	 * EVENT) the AST2400 hardwires. See qemu-model/peripherals/vic.
	 *
	 * Now wired: the QEMU AST2050 SoC uses TYPE_ASPEED_2050_VIC and the C410X
	 * vendor firmware (C4 oracle) boots on it, once the faithful timer emits one
	 * rising-edge pulse per expiry (aspeed_timer.c) instead of toggling — the
	 * toggle only delivered every other expiry under the G3's single-edge config,
	 * halving the guest clock and tripping the vendor watchdog. See
	 * qemu-model/results/vic-hardware-crosscheck.md.
	 */
	compatible = "aspeed,ast2050-vic";
	reg = <0x1e6c0000 0x40>;
};

&uart5 {
	status = "okay";
};

/*
 * Host-facing VUART (0x1e787000) — the AST2050 (G3) Virtual UART the x86 host
 * reaches over LPC (I/O 0x3F8, SIRQ 4; datasheet §29). It is the Serial-over-LAN
 * source: obmc-console-server binds it as /dev/ttyVUART0 (udev rule keyed on
 * iomem_base 0x1E787000) and netipmid exposes it via `ipmitool sol activate`.
 * Raptor's real AST2050 OpenBMC port uses this same block (dev-vuart.c ->
 * mainline 8250_aspeed_vuart.c). The kgpe-d16-bmc QEMU machine models it as a
 * 16550 wired to serial_hd(1). The driver defaults lpc-io-reg=0x3f8 / sirq=4
 * (COM1), which match this board.
 */
&vuart {
	status = "okay";
};

/*
 * LPC host-to-BMC control + port-80h POST-code snoop (B1b/B1c). The AST2050 G3
 * LPC block (0x1e789000) carries the same HICRx/SNPWADR/SNPWDR registers as the
 * AST2400 at identical offsets, so mainline aspeed-lpc-ctrl / aspeed-lpc-snoop
 * bind unchanged. lpc-snoop captures the host's I/O-port-0x80 (POST code) writes
 * into a kfifo exposed at /dev/aspeed-lpc-snoop0; lpc-ctrl exposes the host
 * LPC-mapped window at /dev/aspeed-lpc-ctrl0. Full capture needs a host LPC
 * master (present on real silicon = the SP5100; the BMC-only QEMU machine
 * validates the BMC-side driver bind + register setup).
 */
&lpc_ctrl {
	status = "okay";
};

&lpc_snoop {
	status = "okay";
	snoop-ports = <0x80>;
};

/*
 * Host-side IPMI over LPC KCS (F5b — local host<->BMC channel). The AST2050 (G3)
 * LPC controller at 0x1e789000 exposes three H8S/2168-style KCS channels; each is
 * an IDRn/ODRn/STRn register triple (datasheet §30.3, p.315; DATASHEET-LPC.md):
 *   ch1 0x24/0x30/0x3c   ch2 0x28/0x34/0x40   ch3 0x2c/0x38/0x44
 * These offsets are IDENTICAL on the AST2400, so mainline kcs_bmc_aspeed binds
 * unchanged: drivers/char/ipmi/kcs_bmc_aspeed.c defines LPC_IDR1=0x024 ...
 * LPC_STR3=0x044, exactly matching the datasheet. The faithful QEMU G3 LPC model
 * (qemu/hw/misc/aspeed_lpc_ast2050.c) services these registers (RW config/data,
 * read-only KCS status STR1-3). NB: BT is NOT wired here — on the G3 the BT block
 * is at 0x48-0x68 (H8S layout), but mainline's aspeed,ast2400-ibt-bmc / bt-bmc.c
 * hardcode the AST2400 0x140 offset, which is beyond this SoC's LPC register file
 * (model window 0x00-0x9F) and unimplemented on real AST2050 silicon — so KCS is
 * the only mainline-drivable host-IPMI channel on this SoC. See HOST-KCS-BT-STATUS.md.
 *
 * Channel 3 is the classic IPMI SMS "system interface": host I/O port 0xca2 (data
 * 0xca2 / status+command 0xca3), the OpenBMC convention. The kernel binds
 * kcs_bmc_aspeed + the cdev-ipmi client (CONFIG_IPMI_KCS_BMC_CDEV_IPMI) and creates
 * /dev/ipmi-kcs3, which OpenBMC's host-IPMI bridge (phosphor-ipmi-kcs / kcsbridge)
 * opens to feed ipmid. LPC IRQ = VIC #8 (datasheet §10 Table 36, p.99; SoC memmap
 * ASPEED_DEV_LPC=8), the host->BMC IBF completion.
 */
&lpc {
	kcs3: kcs@2c {
		compatible = "aspeed,ast2400-kcs-bmc-v2";
		reg = <0x2c 0x1>, <0x38 0x1>, <0x44 0x1>;
		aspeed,lpc-io-reg = <0xca2>;
		interrupts = <8>;
		/*
		 * Hold the LPC clock (G3 SCU0C[8] "Stop LCLK") while KCS is
		 * up. No other enabled node references LCLK on this board, so
		 * without this clk_disable_unused() stops the LPC clock and
		 * the whole host-facing LPC block (KCS + the VUART SOL data
		 * path) dies on real silicon — the latent sibling of finding
		 * #94 (see G3-CLK-PROGRESS.md). Consumed by the
		 * kcs_bmc_aspeed optional-clock patch (0004).
		 */
		clocks = <&syscon ASPEED_CLK_GATE_LCLK>;
		status = "okay";
	};
};

&mac0 {
	status = "okay";
	/*
	 * AST2050 (G3) MAC, register-compatible with the AST2400. phy-mode=rmii
	 * with the real RTL8201CP PHY (no fixed-link) -- matching the real board.
	 * The eth0 RX=0 bug is NOT a PHY/RMII issue: on the G3 a MAC SW_RST clears
	 * the MACCR speed bit, and the mainline driver's preserve-only start_hw()
	 * leaves the MAC in 10M timing on the 100M link -> rx=0. The kgpe-d16-bmc
	 * QEMU MAC models that; the kernel cur_speed patch fixes it. The fix is
	 * FAST_MODE alone -- it does not depend on this DTS, which is why no
	 * fixed-link workaround is needed here.
	 */
	phy-mode = "rmii";
};

/*
 * MAC2 (0x1e680000) = the RMII2 NC-SI sideband to the two Intel 82574L host
 * NICs (schematic §7; SCU70[8:6]=110 strap-enables it on the real board).
 * Disabled by DEFAULT so the single-NIC oracle boots (C2/C4) and the plain
 * NFS/SSH boots are unaffected — MAC1 then has no QEMU backend. The D07 NC-SI
 * test enables this node (fdtput status=okay) and runs QEMU with a second
 * -nic whose slirp backend answers NC-SI. `use-ncsi` selects net/ncsi (no
 * MDIO PHY on this channel). See device-driver-program/ D07.
 */
&mac1 {
	status = "disabled";
	use-ncsi;
	/*
	 * Mux the RMII2 data pins (schematic §7 balls A5/B5/B6/C4/D4/D5, GPIOE
	 * group) to the RMII2 function — WITHOUT this the NC-SI control frames
	 * never physically reach the 82574L NICs and discovery fails with "No
	 * channel found to configure!" (silicon attempt 1, evidence
	 * d07-ncsi/02-...). SCU70[8:6]=110 strap-enables RMII2 on this board.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rmii2_default>;
};

/*
 * Board FRU EEPROM: Holtek HT24LC08 (8 Kbit, U25) on the BMC's direct I2C5
 * engine (schematic §10.2, balls A13/B13 -> Linux i2c-4). The E2 strap is tied
 * high (netlist trace), so it answers at 0x54-0x57, NOT 0x50-0x53 as §10.2's
 * table states. WC# is grounded (write-enabled). This bus is direct (not
 * behind the QU9/QU5 mux), so it is reachable regardless of host power.
 * The 24c08 spans 4 device addresses; at24 binds it at the 0x54 base.
 */
&i2c4 {
	status = "okay";

	fru@54 {
		compatible = "atmel,24c08";
		reg = <0x54>;
	};
};

/*
 * BMC I2C4 engine (DT i2c3) — schematic §10.2 "AMD SB-TSI 0x4C/0x4D", reached
 * through the QU4 level-shift FETs Q56-Q59. The two AMD processor thermal
 * interfaces (P0 @0x4c, P1 @0x4d) bind the Linux sbtsi_temp hwmon driver. On
 * real silicon these only respond while the host CPU(s) are powered.
 */
&i2c3 {
	status = "okay";

	sbtsi@4c {
		compatible = "amd,sbtsi";
		reg = <0x4c>;
	};

	sbtsi@4d {
		compatible = "amd,sbtsi";
		reg = <0x4d>;
	};
};

/*
 * BMC I2C1 engine (DT i2c0) — schematic §10.2 / I2C-SMBUS-TOPOLOGY §3.1: the
 * dedicated PSU SMBus (connector PSUSMB1, BMC balls A15/B15 = SDA1/SCL1). The
 * schematic numbers I2C buses 1-based, so schematic "I2C1" is QEMU engine 0 =
 * DT i2c0 (w83795 sits on schematic I2C2 = engine 1 = DT i2c1, confirming the
 * N->N-1 mapping). The QEMU machine attaches the modeled server PSU here
 * (hw/arm/aspeed.c: aspeed_i2c_get_bus(&soc->i2c, 0) -> "pmbus-psu" @0x58).
 * This bus is direct (not behind the QU9/QU5 mux on i2c1), so it is reachable
 * regardless of host power.
 */
&i2c0 {
	status = "okay";

	/*
	 * Generic server-PSU PMBus @0x58. Binds the Linux generic `pmbus` hwmon
	 * driver (CONFIG_SENSORS_PMBUS), which identifies the device via
	 * STATUS_WORD/CAPABILITY and auto-detects VIN/VOUT/IOUT/TEMP/FAN from the
	 * modeled PMBus 1.2 device (hw/sensor/pmbus_psu.c). Row 24 LQ.
	 */
	psu@58 {
		compatible = "pmbus";
		reg = <0x58>;
	};
};

&i2c1 {
	status = "okay";

	/*
	 * Nuvoton/Winbond W83795G hardware monitor -- the KGPE-D16's single
	 * fan/voltage/temperature sensor chip, on the BMC's I2C bus 1 at 0x2f
	 * (Raptor's AST2050 OpenBMC port taps it exactly there; coreboot's
	 * devicetree.cb programs its channel map). The AST2050's own PWM/tach
	 * block is unused on this board -- all sensors come from this chip.
	 *
	 * The mainline drivers/hwmon/w83795.c has no of_match_table, but the I2C
	 * core's DT modalias fallback strips the "winbond," vendor prefix and
	 * matches the driver's i2c_device_id "w83795g", so this node binds and
	 * exposes /sys/bus/i2c/devices/1-002f/hwmon for phosphor-hwmon.
	 * Modelled in QEMU by hw/sensor/w83795.c on the kgpe-d16-bmc machine.
	 */
	hwmon@2f {
		compatible = "winbond,w83795g";
		reg = <0x2f>;
	};
};

/*
 * QU9/QU5/U23 I2C mux fabric behind I2C2 (Linux i2c-1): the DIMM SPD/TSOD
 * buses and the aux-panel/TPM/PCIe-SMBus segment, selected by GPIOF4/F5
 * (AST_I2CS0/1, balls W4/W3). There is NO enable GPIO: QU9's bridge closes
 * automatically while host SYS_PWRGD is high, and U23 hands the select lines
 * to the BMC only once the host BIOS asserts SB_BIOS_POST_COMPLT# (hardware
 * mutex) — with the host off or mid-POST, transactions simply get no ACK or
 * may be routed by the SP5100's choice. Decoded pin-by-pin in
 * schematic-wiring/I2C-MUX-FABRIC-ARBITRATION.md; modeled in QEMU by
 * hw/i2c/kgpe_d16_i2c_fabric.c on the kgpe-d16-bmc machine.
 */
/ {
	i2cmux {
		compatible = "i2c-mux-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-parent = <&i2c1>;
		/* order: bit0 = S0 (GPIOF4), bit1 = S1 (GPIOF5) */
		mux-gpios = <&gpio ASPEED_GPIO(F, 4) GPIO_ACTIVE_HIGH>,
			    <&gpio ASPEED_GPIO(F, 5) GPIO_ACTIVE_HIGH>;

		i2c@0 {
			/* QU5 Y0: aux panel + (via QU9) TPM hdr + PCIe SMBus */
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c@2 {
			/* QU5 Y2 = I2C10: DIMM A-D bank (SPD 0x50-0x57) */
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * Rig population: slot A2 (SA-strap map §5b). The real
			 * A2 module (part RMR5030EF68F9W1600, read on silicon)
			 * is a UDIMM with SPD byte32=0 = no thermal sensor, so
			 * on the physical rig 0x19 NAKs and temp@19 does not bind.
			 * The board itself DOES support a TSOD at 0x18+slot (§10.2),
			 * so the node is declared to describe the board capability;
			 * the jc42 driver simply fails to probe when the DIMM lacks
			 * a sensor (rig), and binds when one is present (QEMU
			 * `-M kgpe-d16-bmc,ts-dimm=on`, or a TS-equipped DIMM). #205.
			 */
			spd@51 {
				compatible = "atmel,24c02";
				reg = <0x51>;
				read-only;
			};

			temp@19 {
				compatible = "jedec,jc-42.4-temp";
				reg = <0x19>;
			};
		};

		i2c@3 {
			/* QU5 Y3 = I2C11: DIMM E-H bank (empty on the rig) */
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};

/*
 * ast2050-pinctrl = the G4 pinctrl driver with the G3 strap-phantom quirk
 * (kernel patch 0008). The G3's SCU70 layout differs from the AST2400's
 * (datasheet §18: G3 bit19 = "bypass all PLL", not an ACPI mux select), so
 * G4-table functions gated purely on HW_STRAP1/2 must not block GPIO
 * requests — with the real strap value (SCU70=0x00819582, bit19=0) the
 * stock driver rejects GPIOF5 (the QU5 I2C mux select S1) with -EPERM,
 * killing the /i2cmux probe. Reproduced byte-identically in QEMU once the
 * machine carried the measured strap value.
 */
&pinctrl {
	compatible = "aspeed,ast2050-pinctrl";
};

&wdt1 {
	status = "okay";
};

/*
 * The AST2050 (G3) has ONE watchdog (datasheet §2.13, singular). The reusable
 * aspeed-g4.dtsi inherits a second wdt2@1e785020 from the AST2400; the G3 has no
 * such block (the faithful QEMU machine no longer instantiates it either, #144),
 * so keep it disabled here to match the silicon.
 */
&wdt2 {
	status = "disabled";
};

/*
 * AST2050 (G3) Video Engine (0x1e700000, VIC INT#7) — the KVM screen-capture
 * block (F8). It captures the SoC's own VGA/CRT framebuffer (or an external DVO
 * source) and JPEG/VQ-compresses it for remote KVM; OpenBMC's obmc-ikvm streams
 * the compressed frames. Datasheet §20 (p.232-255) + §9 memory map (p.97) + §10
 * IRQ table (p.99). AST2050-only block (the sibling AST1100 lacks the video
 * compression engine, §1.3.6 p.19). See F8-KVM.md and qemu-model/peripherals/video.
 *
 * Bound by mainline drivers/media/platform/aspeed/aspeed-video.c via the
 * aspeed-g4.dtsi node (compatible "aspeed,ast2400-video-engine"): the driver
 * ioremaps 0x1e700000, requests INT#7, gets the VCLK/ECLK gates, and registers a
 * V4L2 device -> /dev/video0. The AST2050 VR-register file differs from the
 * G4/G5/G6 the driver targets (DATASHEET-VIDEO.md §7), so probe + /dev/video0 is
 * faithful, but actual frame capture (VR004 trigger -> JPEG stream -> INT#7) is a
 * deferred behavioural add-on in the QEMU model (aspeed.video-ast2050 is a
 * register-accurate protection-key + RW model). The kgpe-d16-bmc QEMU machine
 * maps this block; there is no VGA host source in the BMC-only machine, so capture
 * reports no-signal — the achievable QEMU bar is "driver probes + opens the
 * capture device". See F8-KVM.md for the host-VGA-source boundary.
 */
&video {
	/*
	 * Bind the G3 compatible (not the g4.dtsi default) so the driver takes
	 * the jpeg_only path: pure-JPEG via VE_COMP_CTRL[0], DCT selector clamped
	 * to the 8 ROM tables, and software JFIF wrapping of the headerless
	 * entropy the AST2050 engine emits -- exactly as on real silicon (the
	 * real-HW DTB uses the same compatible). The QEMU model emits headerless
	 * entropy when VR060[0] is set, so QEMU now mirrors silicon end to end.
	 */
	compatible = "aspeed,ast2050-video-engine";
	status = "okay";
};

/*
 * AST2050 (G3) USB2.0 device / virtual-hub controller (0x1e6a0000, VIC INT#5) —
 * the BMC's ONLY USB block and the vKVM virtual-HID / virtual-media datapath (F6
 * groundwork; F8 uses it for the HID keyboard/mouse gadget). The AST2050 has NO
 * USB *host* controller (no EHCI/UHCI/OHCI), so "connect USB devices" means the
 * BMC presents virtual devices TO THE SERVER HOST. Datasheet §9 (p.97) + §10
 * (p.99) + §15 (p.154-178). See F6-USB.md + qemu-model/peripherals/usb.
 *
 * Bound by mainline drivers/usb/gadget/udc/aspeed-vhub (an AST2400-family driver).
 * The AST2050 vhub register file differs (7 downstream ports + a 21-endpoint pool
 * vs the AST2400's 5/15), so the faithful G3 counts are set here; a dedicated G3
 * UDC driver + a functional QEMU vhub datapath (so the BMC actually presents a
 * device to the host) are the F8-KVM host-facing follow-ups. QEMU models this
 * block as aspeed.udc-ast2050 @0x1e6a0000. The HID keyboard/mouse gadget the KVM
 * client drives is demonstrated in-guest over dummy_hcd (F8-KVM.md §3).
 */
&vhub {
	status = "okay";
	aspeed,vhub-downstream-ports = <7>;
	aspeed,vhub-generic-endpoints = <21>;
};

/*
 * AST2050 (G3) counter-style RTC (0x1E781000, datasheet §24). The g4.dtsi base
 * declares this node as "aspeed,ast2400-rtc" (BCD layout) and disables it — but
 * the AST2050 RTC is COUNTER-style (COUNTER/RELOAD/CONTROL/RESTART), register-
 * incompatible with the ast2400 driver. Re-point it at the counter-style variant
 * (rtc-aspeed "aspeed,ast2050-rtc") and enable it so Linux gets a working
 * /dev/rtc0. See kernel patch 0009 + qemu-model/peripherals/rtc + #187.
 */
&rtc {
	compatible = "aspeed,ast2050-rtc";
	reg = <0x1e781000 0x20>;
	interrupts = <22>;	/* VIC 22 = the RTC's single IRQ = alarm (silicon-proven #192); wakealarm */
	status = "okay";
};
