#!/bin/sh
# Initramfs init for the ASUS KGPE-D16 BMC (AST2050) under the kgpe-d16-bmc
# QEMU machine. Brings up networking + dropbear so CI can SSH in, then a shell.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
# Modern kernels (C2) auto-create /dev via devtmpfs. The Raptor 2.6.28 kernel
# (C3) predates devtmpfs (added in 2.6.32), so this mount fails there and we
# fall back to the static /dev nodes baked into the cpio (console, null, zero,
# urandom, ptmx, ttyS0/1) — keep going either way.
mount -t devtmpfs devtmpfs /dev 2>&1 || echo "no devtmpfs: using static /dev nodes"
mkdir -p /dev/pts /run /var/run /var/log /etc/dropbear /root/.ssh
mount -t devpts devpts /dev/pts

hostname kgpe-d16-bmc
echo
echo "ASUS KGPE-D16 BMC  —  Aspeed AST2050 (ARM926EJ-S)  —  $(uname -r)"
echo

# Networking: loopback + eth0.
ip link set lo up
ip link set eth0 up
# QEMU user-net is deterministic (guest 10.0.2.15, gateway 10.0.2.2). Configure
# statically — busybox udhcpc obtains a lease but needs a script to actually
# apply the address, which a minimal initramfs doesn't ship.
# On REAL HARDWARE the BMC net differs (board 192.168.66.2/24, Pi bridge
# 192.168.66.1), so 'bmcip=<addr/len>' and 'bmcgw=<addr>' on the kernel cmdline
# override the QEMU defaults. (The f8capture/vediag gates below hard-switch to the
# rig net the same way; this makes it general for every gate, incl. usbiphost.)
IPCIDR=10.0.2.15/24
GW=10.0.2.2
for _tok in $(cat /proc/cmdline); do
	case "$_tok" in
		bmcip=*) IPCIDR="${_tok#bmcip=}" ;;
		bmcgw=*) GW="${_tok#bmcgw=}" ;;
	esac
done
ip addr add "$IPCIDR" dev eth0
ip route add default via "$GW" 2>&1 || true
ip addr show eth0 2>&1 | sed -n 's/.*inet \([0-9.]*\).*/eth0: \1/p'

# SSH: dropbear with key auth (the test pubkey is in /root/.ssh/authorized_keys).
# Only an ed25519 host key — fast to generate on the emulated ARM926 (RSA keygen
# would be very slow). -R also fills in any other key types a client requests.
dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key 2>&1 | grep -i fingerprint || true
# -E: log to stderr (console) so connection attempts are visible.
dropbear -R -E -p 22 2>&1
sleep 2
echo "--- net diag ---"
ip addr show eth0 2>&1
netstat -tln 2>&1 || true
echo "dropbear: listening on :22 (ssh in via the QEMU hostfwd port)"

# --- F6 USB demo (only when 'f6usb' is on the kernel cmdline; a no-op otherwise) ---
# The AST2050's only USB block is the USB2.0 device/virtual-hub @0x1e6a0000 (bound by
# aspeed-vhub). It presents virtual devices TO THE SERVER HOST — which QEMU does not
# emulate — so we demonstrate the USB *gadget* stack enumerating a virtual mass-storage
# device IN-GUEST over dummy_hcd (a software UDC+host loopback). Groundwork for F8-KVM
# (obmc-ikvm HID + virtual-media). See openbmc/bmc-functionality/F6-USB.md.
if grep -q f6usb /proc/cmdline; then
	echo "=== F6-USB-DEMO-BEGIN ==="
	echo "--- USB device controllers the kernel found (/sys/class/udc) ---"
	ls -1 /sys/class/udc/ 2>&1 || echo "(none)"
	echo "--- aspeed-vhub / dummy_hcd probe (dmesg) ---"
	dmesg | grep -iE 'aspeed_vhub|dummy_hcd|Initialized virtual hub' || echo "(none)"

	echo "--- build a virtual mass-storage gadget via configfs ---"
	mount -t configfs none /sys/kernel/config 2>&1 || echo "(configfs already mounted)"
	G=/sys/kernel/config/usb_gadget/vmedia
	mkdir -p "$G"
	echo 0x1d6b > "$G/idVendor"     # Linux Foundation
	echo 0x0104 > "$G/idProduct"    # Multifunction Composite Gadget
	mkdir -p "$G/strings/0x409"
	echo "ASUS-KGPE-D16-BMC"                          > "$G/strings/0x409/manufacturer"
	echo "AST2050 vKVM virtual-media (F6 groundwork)" > "$G/strings/0x409/product"
	echo "0000A5T2050"                                > "$G/strings/0x409/serialnumber"
	mkdir -p "$G/configs/c.1/strings/0x409"
	echo "vmedia-config" > "$G/configs/c.1/strings/0x409/configuration"
	# small backing image = the "remote media" the BMC would export to the host
	dd if=/dev/zero of=/tmp/vmedia.img bs=4096 count=256 2>&1
	mkdir -p "$G/functions/mass_storage.0"
	echo /tmp/vmedia.img > "$G/functions/mass_storage.0/lun.0/file"
	ln -s "$G/functions/mass_storage.0" "$G/configs/c.1/"
	# Bind to the software dummy UDC so the paired dummy HOST enumerates it in-guest.
	UDC=$(ls /sys/class/udc | grep -i dummy | head -1)
	echo "binding vmedia gadget -> UDC '$UDC'"
	echo "$UDC" > "$G/UDC"
	sleep 3
	echo "--- enumeration result (dmesg) ---"
	dmesg | grep -iE 'new .*USB device|Mass Storage|Product: AST2050|Direct-Access|scsi' | tail -15
	echo "--- enumerated USB devices (product strings) ---"
	for p in /sys/bus/usb/devices/*/product; do
		[ -f "$p" ] && echo "$p = $(cat "$p")"
	done 2>&1
	echo "=== F6-USB-DEMO-END ==="
fi

# --- F8 KVM-over-IP demo (only when 'f8kvm' is on the kernel cmdline) ---
# KVM-over-IP on the AST2050 is three cooperating blocks (see F8-KVM.md):
#   1. VIDEO ENGINE @0x1e700000 (VIC INT#7): the aspeed-video V4L2 driver captures
#      the host VGA framebuffer -> /dev/video0. The BMC-only QEMU machine has no VGA
#      host source, so this proves "driver probes the modeled engine + opens the
#      capture device" (the achievable QEMU bar; the host-VGA source is the boundary).
#   2. USB2.0 vhub @0x1e6a0000 (VIC INT#5): a virtual HID keyboard+mouse gadget the
#      BMC presents TO THE SERVER HOST. QEMU does not emulate that host, so we bind
#      the gadget to the in-guest dummy_hcd (a software UDC+host loopback) and show
#      the exact keypress byte-stream reaching a host-side input (evdev) device.
# The real host-facing path (vhub -> real server host) needs a dedicated G3 UDC
# driver + a functional QEMU vhub datapath (F6/F8 boundary).
if grep -q f8kvm /proc/cmdline; then
	echo "=== F8-KVM-DEMO-BEGIN ==="

	echo "--- [1] VIDEO ENGINE: aspeed-video probe (dmesg) ---"
	dmesg | grep -iE 'aspeed.?video|video-engine|1e700000' || echo "(no aspeed-video dmesg)"
	echo "--- video capture device nodes ---"
	ls -l /dev/video* 2>&1 || echo "(no /dev/video*)"
	for d in /sys/class/video4linux/video*; do
		[ -e "$d" ] && echo "$d/name = $(cat "$d/name" 2>&1)"
	done 2>&1
	if [ -e /dev/video0 ]; then
		echo "F8-VIDEO: /dev/video0 present (aspeed-video bound the AST2050 video engine)"
	else
		echo "F8-VIDEO-FAIL: no /dev/video0"
	fi

	echo "--- [2] USB2.0 vhub probe (dmesg) ---"
	dmesg | grep -iE 'aspeed_vhub|Initialized virtual hub|dummy_hcd' || echo "(none)"
	echo "--- UDCs found (/sys/class/udc) ---"
	ls -1 /sys/class/udc/ 2>&1 || echo "(none)"

	echo "--- [3] build a virtual HID keyboard+mouse gadget via configfs ---"
	mount -t configfs none /sys/kernel/config 2>&1 || echo "(configfs already mounted)"
	G=/sys/kernel/config/usb_gadget/vkvm
	mkdir -p "$G"
	echo 0x1d6b > "$G/idVendor"     # Linux Foundation
	echo 0x0104 > "$G/idProduct"    # Multifunction Composite Gadget
	mkdir -p "$G/strings/0x409"
	echo "ASUS-KGPE-D16-BMC"                        > "$G/strings/0x409/manufacturer"
	echo "AST2050 vKVM keyboard+mouse (obmc-ikvm)"  > "$G/strings/0x409/product"
	echo "0000A5T2050"                              > "$G/strings/0x409/serialnumber"
	mkdir -p "$G/configs/c.1/strings/0x409"
	echo "vkvm-hid-config" > "$G/configs/c.1/strings/0x409/configuration"

	# --- HID keyboard function (hid.usb0): boot keyboard, 8-byte reports ---
	mkdir -p "$G/functions/hid.usb0"
	echo 1 > "$G/functions/hid.usb0/protocol"      # 1 = keyboard
	echo 1 > "$G/functions/hid.usb0/subclass"      # 1 = boot interface
	echo 8 > "$G/functions/hid.usb0/report_length" # 8-byte boot-keyboard report
	# Standard 63-byte USB HID boot-keyboard report descriptor.
	printf '\x05\x01\x09\x06\xa1\x01\x05\x07\x19\xe0\x29\xe7\x15\x00\x25\x01\x75\x01\x95\x08\x81\x02\x95\x01\x75\x08\x81\x03\x95\x05\x75\x01\x05\x08\x19\x01\x29\x05\x91\x02\x95\x01\x75\x03\x91\x03\x95\x06\x75\x08\x15\x00\x25\x65\x05\x07\x19\x00\x29\x65\x81\x00\xc0' \
		> "$G/functions/hid.usb0/report_desc"

	# --- HID mouse function (hid.usb1): boot mouse, 3-byte reports ---
	mkdir -p "$G/functions/hid.usb1"
	echo 2 > "$G/functions/hid.usb1/protocol"      # 2 = mouse
	echo 1 > "$G/functions/hid.usb1/subclass"      # 1 = boot interface
	echo 3 > "$G/functions/hid.usb1/report_length" # 3-byte boot-mouse report
	# Standard 50-byte USB HID boot-mouse report descriptor.
	printf '\x05\x01\x09\x02\xa1\x01\x09\x01\xa1\x00\x05\x09\x19\x01\x29\x03\x15\x00\x25\x01\x95\x03\x75\x01\x81\x02\x95\x01\x75\x05\x81\x03\x05\x01\x09\x30\x09\x31\x15\x81\x25\x7f\x75\x08\x95\x02\x81\x06\xc0\xc0' \
		> "$G/functions/hid.usb1/report_desc"

	echo "--- report descriptors the gadget will expose to the host ---"
	echo "keyboard report_desc ($(wc -c < "$G/functions/hid.usb0/report_desc") bytes):"
	hexdump -C "$G/functions/hid.usb0/report_desc" 2>&1 | head -5
	echo "mouse report_desc ($(wc -c < "$G/functions/hid.usb1/report_desc") bytes):"
	hexdump -C "$G/functions/hid.usb1/report_desc" 2>&1 | head -4

	ln -s "$G/functions/hid.usb0" "$G/configs/c.1/"
	ln -s "$G/functions/hid.usb1" "$G/configs/c.1/"

	# Bind to the software dummy UDC so the paired dummy HOST enumerates the HID
	# keyboard+mouse in-guest (stands in for the real server host).
	UDC=$(ls /sys/class/udc | grep -i dummy | head -1)
	echo "binding vkvm HID gadget -> UDC '$UDC'"
	echo "$UDC" > "$G/UDC"
	sleep 3

	echo "--- host-side enumeration of the virtual keyboard+mouse (dmesg) ---"
	dmesg | grep -iE 'new .*USB device|hid-generic|input:|Product: AST2050' | tail -12
	echo "--- gadget HID endpoints (/dev/hidgN = the report streams to the host) ---"
	ls -l /dev/hidg* 2>&1 || echo "(no /dev/hidg*)"
	echo "--- host input devices bound to the enumerated HID (evdev) ---"
	ls -l /sys/class/input/ 2>&1 | grep -iE 'event|input' || true

	# --- [4] SEND A KEYBOARD EVENT: press 'a' (HID usage 0x04) then release ---
	# Capture the delivered input_event on the *vKVM keyboard* evdev node (NOT the
	# board gpio-keys button). /proc/bus/input/devices tags the keyboard's handler
	# line with 'kbd'; pick its eventN. An input_event is 16 bytes on 32-bit ARM:
	# {tv_sec,tv_usec (8), __u16 type, __u16 code, __s32 value}; a KEY_A press is
	# type=EV_KEY(0x0001) code=KEY_A(0x001e=30) value=1 -> bytes '01 00 1e 00 01 00 00 00'.
	# Find the vKVM *keyboard* evdev node via sysfs: it is the input device whose
	# name contains 'vKVM' and whose REL capability bitmask is 0 (the mouse has
	# REL_X|REL_Y set); this avoids grabbing the mouse or the board gpio-keys button.
	KBD_EV=""
	for e in /sys/class/input/event*; do
		[ -e "$e/device/name" ] || continue
		n=$(cat "$e/device/name")
		rel=$(cat "$e/device/capabilities/rel")
		case "$n" in
			*vKVM*) [ "$rel" = "0" ] && KBD_EV=$(basename "$e") && break ;;
		esac
	done
	EV="/dev/input/${KBD_EV}"
	echo "vKVM keyboard evdev node: ${KBD_EV:-<none>} ($EV)"
	if [ -n "$KBD_EV" ] && [ -e "$EV" ]; then
		# cat writes raw bytes to the file as they arrive (more reliable than a
		# buffered formatter); we hexdump the captured file after the keypress.
		( cat "$EV" > /tmp/kbd_event.bin ) &
		READER=$!
		sleep 1
	fi
	echo "--- writing keyboard report to /dev/hidg0: press 'a' then release ---"
	# 8-byte boot-keyboard report: [modifiers][reserved][k1..k6]; k1=0x04 = 'a'.
	printf '\x00\x00\x04\x00\x00\x00\x00\x00' > /dev/hidg0 && \
		echo "F8-HID: wrote press report (a) to /dev/hidg0" || echo "F8-HID-FAIL: hidg0 write failed"
	sleep 1
	printf '\x00\x00\x00\x00\x00\x00\x00\x00' > /dev/hidg0   # release
	sleep 1
	echo "--- mouse report to /dev/hidg1: move +10,+5, left button ---"
	# 3-byte boot-mouse report: [buttons][dx][dy]; 0x01=left btn, dx=+10, dy=+5.
	printf '\x01\x0a\x05' > /dev/hidg1 && echo "F8-HID: wrote mouse report to /dev/hidg1" || echo "(mouse write failed)"
	sleep 1
	if [ -n "${READER:-}" ]; then kill "$READER" 2>&1 || true; fi
	echo "--- host received these input_event bytes on $EV (the keypress crossing to the host) ---"
	if [ -s /tmp/kbd_event.bin ]; then
		hexdump -C /tmp/kbd_event.bin | head -8
		if hexdump -C /tmp/kbd_event.bin | grep -q '01 00 1e 00 01 00 00 00'; then
			echo "F8-HID-EVENT: host evdev received EV_KEY KEY_A press (value=1) -- keypress crossed to the host"
		fi
	else
		echo "(no evdev capture)"
	fi
	dmesg | grep -iE 'input:|hid-generic|Keyboard|Mouse' | tail -6

	echo "=== F8-KVM-DEMO-END ==="
fi

# --- F8 VIDEO DATAPATH demo (only when 'f8video' is on the kernel cmdline) ---
# "See the virtual VGA screen" with ACTUAL PIXELS: on the KGPE-D16 the AST2050
# IS the host's VGA adapter — the host framebuffer lives in BMC DRAM (the 8 MB
# vga_memory carve-out at 0x43800000, SCU70[3:2]-strapped; see the DTS). The
# static f8video tool (initramfs/f8video.c):
#   1. writes an 8-bar colour test pattern into that carve-out via /dev/mem
#      (standing in for "the host rendered something" — on real HW the host GPU
#      path writes this same DRAM);
#   2. captures one frame from /dev/video0: aspeed-video programs the AST2050
#      video engine, VR004 triggers capture+compression, the engine reads the
#      VGA scanout, JPEG-compresses it into the driver's vb2 buffer and raises
#      VIC INT#7, and the dequeued V4L2 buffer IS the JPEG;
#   3. emits the frame as base64 between F8-FRAME-BEGIN/END so the boot harness
#      (scripts/video-capture-test.py) can decode it and verify the pattern.
if grep -q f8video /proc/cmdline; then
	echo "=== F8-VIDEO-DEMO-BEGIN ==="
	dmesg | grep -iE 'aspeed.?video|video-engine|1e700000' || echo "(no aspeed-video dmesg)"
	if [ -e /dev/video0 ]; then
		echo "F8-VIDEO: /dev/video0 present (aspeed-video bound the AST2050 video engine)"
		f8video 0x43800000 || echo "F8-VIDEO-FAIL: f8video exited $?"
	else
		echo "F8-VIDEO-FAIL: no /dev/video0"
	fi
	echo "=== F8-VIDEO-DEMO-END ==="
fi

# --- VE register diagnostic (only when 'vediag' is on the cmdline) ---
# Sample the AST2050 video-engine registers *during* a capture to localize the
# G3 compression stall: does CAP_BUSY(SEQ bit16) set/clear? does COMP_BUSY(bit18)
# stick? does any interrupt latch in INT_STATUS(308: CAPTURE_COMPLETE bit1 /
# COMP_COMPLETE bit3)? does COMP_SIZE(078) ever go non-zero? See REAL-HW-VIDEO-CAPTURE.md.
if grep -q vediag /proc/cmdline; then
	echo "=== VEDIAG-BEGIN ==="
	ip addr del 10.0.2.15/24 dev eth0 2>&1 || true
	ip addr add 192.168.66.2/24 dev eth0 2>&1 || true
	echo "pre : SEQ004=$(devmem 0x1e700004) CTRL008=$(devmem 0x1e700008) COMPC060=$(devmem 0x1e700060) JPGA040=$(devmem 0x1e700040) INTC304=$(devmem 0x1e700304) INTS308=$(devmem 0x1e700308)"
	F8_NBUFS=2 f8capture /tmp/bios.jpg 40 > /tmp/f8.log 2>&1 &
	CPID=$!
	i=0
	while [ $i -lt 14 ]; do
		echo "t$i: SEQ004=$(devmem 0x1e700004) INTS308=$(devmem 0x1e700308) COMPSZ078=$(devmem 0x1e700078) COMPADDR054=$(devmem 0x1e700054) COMPC060=$(devmem 0x1e700060)"
		i=$((i + 1))
		sleep 1
	done
	wait $CPID
	echo "f8capture rc=$?; log:"; cat /tmp/f8.log
	echo "post: SEQ004=$(devmem 0x1e700004) INTS308=$(devmem 0x1e700308) COMPSZ078=$(devmem 0x1e700078)"
	echo "=== VEDIAG-END ==="
fi

# --- Real-silicon BIOS/host VGA capture (only when 'f8capture' is on the cmdline) ---
# On the real AST2050 the aspeed-video engine captures the LIVE host VGA output
# (the host's onboard VGA IS this SoC, framebuffer in shared DRAM). A minimal
# initramfs (no OpenBMC) keeps the box idle + memory-rich, so the capture runs
# without the M-bus/OOM starvation full OpenBMC hits in 64 MB. Reconfigure eth0
# for the real BMC net, grab one JPEG from /dev/video0 and emit it as base64.
if grep -q f8capture /proc/cmdline; then
	echo "=== F8-CAPTURE-BEGIN ==="
	ip addr del 10.0.2.15/24 dev eth0 2>&1 || true
	ip addr add 192.168.66.2/24 dev eth0 2>&1 || true
	ip route add default via 192.168.66.1 2>&1 || true
	ip addr show eth0 2>&1 | sed -n 's/.*inet \([0-9.]*\).*/eth0: \1/p'
	dmesg | grep -iE 'aspeed.?video|video-engine|1e700000' || echo "(no aspeed-video dmesg)"
	if [ -e /dev/video0 ]; then
		echo "F8-CAPTURE: /dev/video0 present"
		F8_NBUFS=2 f8capture /tmp/bios.jpg 40 || echo "F8-CAPTURE: f8capture exited $?"
		if [ -s /tmp/bios.jpg ]; then
			echo "F8-CAPTURE-SIZE: $(wc -c < /tmp/bios.jpg) bytes"
			echo "F8-FRAME-BEGIN"
			base64 /tmp/bios.jpg
			echo "F8-FRAME-END"
		else
			echo "F8-CAPTURE-FAIL: no /tmp/bios.jpg produced"
		fi
	else
		echo "F8-CAPTURE-FAIL: no /dev/video0"
	fi
	echo "=== F8-CAPTURE-END ==="
fi

# --- USB/IP host-export gate (only when 'usbiphost' is on the kernel cmdline) ---
# Export the BMC's USB gadget (HID keyboard = feature #3b + mass-storage = feature
# #2) over USB/IP so a SEPARATE qemu-system-x86_64 "virtual host" can import it
# (usbip attach / vhci-hcd) and perform FULL enumeration against an independent USB
# stack -- the piece the in-guest dummy_hcd loopback (F6/F8) structurally cannot
# show. The gadget binds to the usbip-vudc UDC, NOT the faithful aspeed.udc-ast2050
# vhub: a gadget binds ONE UDC at a time, so this is the UDC-agnostic FUNCTION /
# descriptor / enumeration test, COMPLEMENTARY to (not a replacement for) the
# patch-0007 vhub probe test. usbipd serialises the gadget's URBs on TCP:3240; the
# runner (scripts/usbip-host-test.py) forwards that to the x86 guest.
# See openbmc/bmc-functionality/F6-USB-HOST.md.
if grep -q usbiphost /proc/cmdline; then
	echo "=== USBIP-EXPORT-BEGIN ==="
	echo "--- UDCs present (expect usbip-vudc.0) ---"
	ls -1 /sys/class/udc/ 2>&1 || echo "(none)"

	mount -t configfs none /sys/kernel/config 2>&1 || echo "(configfs already mounted)"
	G=/sys/kernel/config/usb_gadget/usbipexport
	mkdir -p "$G"
	echo 0x1d6b > "$G/idVendor"     # Linux Foundation
	echo 0x0104 > "$G/idProduct"    # Multifunction Composite Gadget
	mkdir -p "$G/strings/0x409"
	echo "ASUS-KGPE-D16-BMC"                 > "$G/strings/0x409/manufacturer"
	echo "AST2050 vKVM export (usbip)"       > "$G/strings/0x409/product"
	echo "0000A5T2050"                       > "$G/strings/0x409/serialnumber"
	mkdir -p "$G/configs/c.1/strings/0x409"
	echo "usbip-export-config" > "$G/configs/c.1/strings/0x409/configuration"

	# HID keyboard (feature #3b): boot keyboard, 8-byte reports. Same standard
	# 63-byte boot-keyboard report descriptor as the F8 vKVM gadget.
	mkdir -p "$G/functions/hid.usb0"
	echo 1 > "$G/functions/hid.usb0/protocol"      # keyboard
	echo 1 > "$G/functions/hid.usb0/subclass"      # boot interface
	echo 8 > "$G/functions/hid.usb0/report_length"
	printf '\x05\x01\x09\x06\xa1\x01\x05\x07\x19\xe0\x29\xe7\x15\x00\x25\x01\x75\x01\x95\x08\x81\x02\x95\x01\x75\x08\x81\x03\x95\x05\x75\x01\x05\x08\x19\x01\x29\x05\x91\x02\x95\x01\x75\x03\x91\x03\x95\x06\x75\x08\x15\x00\x25\x65\x05\x07\x19\x00\x29\x65\x81\x00\xc0' \
		> "$G/functions/hid.usb0/report_desc"

	# Mass storage (feature #2 virtual media): a backing image carrying a known
	# magic at a fixed offset, so the host proves data transport by reading it back
	# from /dev/sdX (no mkfs needed in the minimal initramfs).
	USBIP_MAGIC="KGPE-D16-USBIP-VMEDIA-OK"
	dd if=/dev/zero of=/tmp/vmedia.img bs=4096 count=256 2>&1
	printf '%s' "$USBIP_MAGIC" | dd of=/tmp/vmedia.img bs=1 seek=512 conv=notrunc 2>&1
	mkdir -p "$G/functions/mass_storage.0"
	echo /tmp/vmedia.img > "$G/functions/mass_storage.0/lun.0/file"

	ln -s "$G/functions/hid.usb0"       "$G/configs/c.1/"
	ln -s "$G/functions/mass_storage.0" "$G/configs/c.1/"

	# Bind the gadget to the usbip virtual UDC.
	VUDC=$(ls /sys/class/udc | grep -i usbip | head -1)
	echo "binding export gadget -> UDC '$VUDC'"
	if [ -n "$VUDC" ] && echo "$VUDC" > "$G/UDC"; then
		echo "USBIP-BIND-OK (gadget bound to $(cat "$G/UDC"))"
	else
		echo "USBIP-BIND-FAIL"
	fi
	# Confirm the mass-storage backing file actually attached (the dmesg at
	# function-create time prints "(no medium)" before the file is set; read it
	# back after bind to prove the medium is present for the host to read).
	LUNFILE=$(cat "$G/functions/mass_storage.0/lun.0/file" 2>&1)
	if [ -n "$LUNFILE" ]; then
		echo "USBIP-LUN-MEDIUM-OK (lun.0 file=$LUNFILE)"
	else
		echo "USBIP-LUN-NO-MEDIUM (backing file not attached)"
	fi

	# Start the USB/IP device-mode daemon: exports the bound vudc gadget on TCP:3240
	# for a remote 'usbip attach'. -D daemonises; --device = device (vudc) mode.
	usbipd -D --device 2>&1 || echo "usbipd start rc=$?"
	sleep 2
	if grep -q usbipdiag /proc/cmdline; then
		echo "--- VUDC-DIAG: udc class ---"; ls -la /sys/class/udc/ 2>&1
		echo "--- VUDC-DIAG: platform usbip-vudc.0 (dev_desc?) ---"
		ls -la /sys/devices/platform/usbip-vudc.0/ 2>&1
		echo "--- VUDC-DIAG: usbip_status ---"
		cat /sys/devices/platform/usbip-vudc.0/usbip_status 2>&1
		echo "--- VUDC-DIAG: udc device uevent (USB_UDC_NAME?) ---"
		cat /sys/class/udc/usbip-vudc.0/uevent 2>&1
		echo "--- VUDC-DIAG: usbip list -r 127.0.0.1 (self-query) ---"
		usbip list -r 127.0.0.1 2>&1
	fi
	if netstat -tln 2>&1 | grep -q ':3240'; then
		echo "USBIP-DAEMON-LISTENING (:3240)"
	else
		echo "USBIP-DAEMON-FAIL (:3240 not listening)"
	fi
	echo "USBIP-MAGIC=$USBIP_MAGIC@512"

	# Drive periodic KEY_A press/release on /dev/hidg0 so a host that imports this
	# gadget (usbip attach) observes keystrokes on its evdev (feature #3b). Gated on
	# a separate 'usbipkbd' token so the plain export (Stage 0) stays quiet; the
	# two-VM runner passes both. Backgrounded; retries (writes fail with -ESHUTDOWN
	# until a host is enumerated). stderr -> a file (kept visible, not /dev/null).
	if grep -q usbipkbd /proc/cmdline; then
		( while true; do
			printf '\x00\x00\x04\x00\x00\x00\x00\x00' > /dev/hidg0
			sleep 1
			printf '\x00\x00\x00\x00\x00\x00\x00\x00' > /dev/hidg0
			sleep 1
		done ) 2> /tmp/hidkbd.log &
		echo "USBIP-HIDKBD-LOOP started (periodic KEY_A on /dev/hidg0)"
	fi
	echo "=== USBIP-EXPORT-END ==="
fi

# --- LED drive-observe (only when 'ledtest' is on the kernel cmdline) ---
# DEVICE-MATRIX row 32: prove QEMU emulates BMC LED drive END-TO-END through the
# Linux path (/sys/class/leds -> gpio-leds -> aspeed-gpio -> QEMU model),
# mirroring the silicon LS/LU evidence (evidence/e-gpio-leds/00). The 'identify'
# LED is GPIO(G,0) ACTIVE_LOW, so brightness=1 drives the line LOW (LED on) and
# brightness=0 drives it HIGH (off). We read the line state back from
# /sys/kernel/debug/gpio -- that is the aspeed-gpio driver reading the QEMU data
# register, so a state change there proves the MODEL received the write (not just
# the LED class caching a value).
if grep -q ledtest /proc/cmdline; then
	echo "=== LED-DRIVE-OBSERVE-BEGIN ==="
	mount -t debugfs none /sys/kernel/debug 2>&1 || echo "(debugfs already mounted)"
	echo "--- /sys/class/leds ---"
	ls /sys/class/leds 2>&1
	LED=/sys/class/leds/identify
	if [ ! -d "$LED" ]; then
		echo "LED-TEST: $LED MISSING"
		echo "LED-TEST RESULT: FAIL"
	else
		echo "--- gpio 'out' lines, default (LED off) ---"
		grep -i out /sys/kernel/debug/gpio 2>&1
		echo 1 > "$LED/brightness"; echo "wrote brightness=1 rc=$?"
		ON=$(grep -i identify /sys/kernel/debug/gpio | grep -i out)
		echo "identify ON : $ON"
		echo 0 > "$LED/brightness"; echo "wrote brightness=0 rc=$?"
		OFF=$(grep -i identify /sys/kernel/debug/gpio | grep -i out)
		echo "identify OFF: $OFF"
		if echo "$ON" | grep -q 'out lo' && echo "$OFF" | grep -q 'out hi'; then
			echo "LED-TEST RESULT: PASS"
		else
			echo "LED-TEST RESULT: FAIL (expected ON=out lo, OFF=out hi)"
		fi
	fi
	echo "=== LED-DRIVE-OBSERVE-END ==="
	poweroff -f 2>&1 || true
fi

# --- PMBus PSU validation (only when 'pmbustest' on the kernel cmdline) ---
# DEVICE-MATRIX row 24 (PSU PMBus) LQ: prove the Linux GENERIC pmbus hwmon driver
# (CONFIG_SENSORS_PMBUS) binds to the modeled server PSU @0x58 on the i2c0 engine
# (dts &i2c0 psu@58 compatible="pmbus" — schematic I2C1 = QEMU engine 0) and reads
# telemetry from hw/sensor/pmbus_psu.c. The generic driver identifies via
# STATUS_WORD/CAPABILITY then auto-detects VIN/VOUT/IOUT/TEMP/FAN; a non-zero
# voltage input proves userspace->hwmon->pmbus->QEMU model end to end.
if grep -q pmbustest /proc/cmdline; then
	echo "=== PMBUS-BEGIN ==="
	dmesg 2>&1 | grep -iE "pmbus" | head
	PH=""
	for h in /sys/class/hwmon/hwmon*; do
		[ -e "$h/name" ] || continue
		echo "hwmon $(basename "$h") name=$(cat "$h/name" 2>&1) dev=$(readlink -f "$h/device" 2>&1 | sed 's#.*/##')"
		if readlink -f "$h/device" 2>&1 | grep -q "0-0058"; then PH="$h"; fi
		case "$(cat "$h/name" 2>&1)" in *pmbus*) [ -z "$PH" ] && PH="$h";; esac
	done
	if [ -n "$PH" ]; then
		echo "pmbus hwmon = $PH (name=$(cat "$PH/name" 2>&1))"
		for f in "$PH"/in*_input "$PH"/temp*_input "$PH"/fan*_input "$PH"/curr*_input; do
			[ -e "$f" ] && echo "  $(basename "$f")=$(cat "$f" 2>&1)"
		done
		V=""
		for f in "$PH"/in*_input; do [ -e "$f" ] && V=$(cat "$f" 2>&1) && break; done
		if [ -n "$V" ] && [ "$V" -gt 0 ] 2>&1; then
			echo "PMBUS RESULT: PASS (generic pmbus hwmon bound @0-0058, VOUT/VIN=${V} mV)"
		else
			echo "PMBUS RESULT: FAIL (hwmon bound but no voltage input read)"
		fi
	else
		echo "PMBUS RESULT: FAIL (no pmbus hwmon @0-0058 — driver did not bind)"
	fi
	echo "=== PMBUS-END ==="
	poweroff -f 2>&1 || true
fi

# --- PUART presence check (only when 'puarttest' on the kernel cmdline) ---
# DEVICE-MATRIX row 47 (PUART, 0x1E788000, datasheet §29.4): the AST2050 LPC
# pass-through 16550. Proves the QEMU model backs the register block (SerialMM)
# instead of the 0x1E600000 iomem catch-all (RAZ/WI). Test the 16550 Scratch
# Register (reg 7; with regshift=2 that is byte offset 0x1C -> phys 0x1E78801C):
# it is a pure R/W scratch with no side effects, so a modeled UART persists a
# written pattern while the catch-all always reads back 0. No Linux driver binds
# PUART (the board does not use it), so this is a userspace devmem presence probe.
if grep -q puarttest /proc/cmdline; then
	echo "=== PUART-BEGIN ==="
	SCR=0x1E78801C
	B0=$(devmem "$SCR")
	devmem "$SCR" 32 0xA5
	R1=$(devmem "$SCR")
	devmem "$SCR" 32 0x5A
	R2=$(devmem "$SCR")
	echo "PUART SCR @${SCR}: initial=${B0} after-write-0xA5=${R1} after-write-0x5A=${R2}"
	# busybox devmem prints 0x-prefixed values; compare low byte.
	if [ "$((R1 & 0xFF))" -eq 165 ] && [ "$((R2 & 0xFF))" -eq 90 ]; then
		echo "PUART RESULT: PASS (16550 scratch register R/W persists — PUART modeled @0x1E788000)"
	else
		echo "PUART RESULT: FAIL (scratch did not persist — reg not modeled, catch-all RAZ)"
	fi
	echo "=== PUART-END ==="
	poweroff -f 2>&1 || true
fi

# --- MDMA control-path check (only when 'mdmatest' on the kernel cmdline) ---
# DEVICE-MATRIX row 45 (MDMA, 0x1E740000, §22): the AST2050 memory-copy/fill DMA
# engine. This proves the QEMU model backs the register block + command/status
# CONTROL path (register R/W incl. the 28-bit source/dest address mask; a command
# write to MDMA0C with update-status sets the per-ID done bit in MDMA14; the done
# bit is write-1-to-clear). The actual data MOVEMENT needs the AHBC low-SDRAM
# aperture (MDMA is 28-bit; DRAM is at 0x40000000) and is validated separately by
# a bare-metal fwtest — so this gate deliberately does NOT enable the IRQ mask (a
# level IRQ6 with no Linux handler would be spurious) and fills an unmapped low
# address (harmless no-op).
if grep -q mdmatest /proc/cmdline; then
	echo "=== MDMA-BEGIN ==="
	# 1. register R/W persistence (MDMA00/04 mask to [27:0]).
	devmem 0x1E740000 32 0x12345678       # src: 28-bit mask -> 0x02345678
	SRC=$(devmem 0x1E740000)
	devmem 0x1E740008 32 0xDEADBEEF       # fill pattern
	FILL=$(devmem 0x1E740008)
	STS0=$(devmem 0x1E740014)             # status reset value: expect 0x00000100
	# 2. fire a FILL command (type=10) to an unmapped low addr, ID#0, update-status.
	devmem 0x1E740004 32 0x08000000       # dst = 128 MB (unmapped -> harmless no-op)
	devmem 0x1E74000C 32 0x82000004       # [31]=update [30:28]=ID0 [25:24]=10 fill  len=4
	STS1=$(devmem 0x1E740014)             # expect bit16 set: 0x00010100
	# 3. write-1-to-clear the ID#0 done bit.
	devmem 0x1E740014 32 0x00010000
	STS2=$(devmem 0x1E740014)             # expect bit16 cleared: back to 0x00000100
	echo "MDMA src(28b-masked)=${SRC} fill=${FILL} sts_reset=${STS0} sts_after_cmd=${STS1} sts_after_w1c=${STS2}"
	OK=1
	[ "$((SRC & 0xFFFFFFFF))" -eq "$((0x02345678))" ] || OK=0    # 28-bit mask applied
	[ "$((FILL & 0xFFFFFFFF))" -eq "$((0xDEADBEEF))" ] || OK=0   # fill persists
	[ "$((STS0 & 0xFFFFFFFF))" -eq "$((0x00000100))" ] || OK=0   # reset value
	[ "$((STS1 & 0x10000))" -ne 0 ] || OK=0                      # done bit set on command
	[ "$((STS2 & 0x10000))" -eq 0 ] || OK=0                      # done bit W1C-cleared
	if [ "$OK" -eq 1 ]; then
		echo "MDMA RESULT: PASS (register + command->status control path modelled; 28-bit addr mask + W1C ok)"
	else
		echo "MDMA RESULT: FAIL (control path not modelled as expected)"
	fi
	echo "=== MDMA-END ==="
	poweroff -f 2>&1 || true
fi

# --- WDT userspace validation (only when 'wdttest' on the kernel cmdline) ---
# DEVICE-MATRIX row 38 (WDT) LU: prove userspace interfaces with the aspeed WDT
# via /dev/watchdog. busybox watchdog issues WDIOC_SETTIMEOUT from userspace; we
# read the value + the live countdown back from /sys/class/watchdog/watchdog0
# (WATCHDOG_SYSFS). Those attrs are the watchdog-core reading the aspeed_wdt
# driver, which reads the QEMU aspeed.wdt model's counter registers -- so
# timeout==N and a numeric, counting timeleft prove the userspace ioctl reached
# the model end-to-end (userspace -> /dev/watchdog -> aspeed_wdt -> QEMU model).
# No reset needed to prove the interface (the WDT reset itself is row-38 QE/ZS).
if grep -q wdttest /proc/cmdline; then
	echo "=== WDT-USERSPACE-BEGIN ==="
	ls -la /dev/watchdog* 2>&1
	WD=/sys/class/watchdog/watchdog0
	echo "identity=$(cat $WD/identity 2>&1)"
	echo "state(pre-arm)=$(cat $WD/state 2>&1)"
	# Arm from userspace: 30s timeout, pet every 5s (busybox daemonises).
	busybox watchdog -T 30 -t 5 /dev/watchdog 2>&1
	sleep 3
	TMO=$(cat $WD/timeout 2>&1)
	ST=$(cat $WD/state 2>&1)
	# aspeed_wdt does not implement get_timeleft, so timeleft may be absent -- probe
	# it honestly (test -e) instead of letting cat error.
	if [ -e "$WD/timeleft" ]; then TL=$(cat $WD/timeleft 2>&1); else TL="(not exposed by aspeed_wdt)"; fi
	echo "timeout=$TMO state=$ST timeleft=$TL"
	# Stop the pet daemon (busybox watchdog in this build does not magic-close on
	# SIGTERM, so the WDT stays armed -- harmless: poweroff -f below exits QEMU
	# well before the 30s expiry).
	kill "$(pidof watchdog)" 2>&1 || echo "(no watchdog pid to kill)"
	sleep 1
	echo "state(post-kill)=$(cat $WD/state 2>&1)"
	# PASS = userspace WDIOC_SETTIMEOUT reached the driver (timeout reads back 30)
	# AND the WDT is armed (state active). aspeed_wdt does not expose timeleft, so
	# we do NOT gate on it; the WDT actually RESETTING the SoC is row-38 QE/ZS
	# (proven separately). This gate proves the userspace /dev/watchdog API path
	# (open -> SETTIMEOUT -> start -> keepalive) works end to end.
	if [ "$TMO" = "30" ] && [ "$ST" = "active" ]; then
		echo "WDT-USERSPACE RESULT: PASS (timeout=$TMO active; timeleft not exposed by aspeed_wdt)"
	else
		echo "WDT-USERSPACE RESULT: FAIL (timeout=$TMO state=$ST)"
	fi
	echo "=== WDT-USERSPACE-END ==="
	poweroff -f 2>&1 || true
fi

# --- WDT userspace-triggered RESET (only when 'wdtreset' on the kernel cmdline) ---
# DEVICE-MATRIX row 38 (WDT) LU ✅ upgrade: prove a USERSPACE action causes a real
# SoC reset. busybox watchdog -T 3 arms a 3s timeout; -t 60 makes it NOT re-pet for
# 60s, so the WDT expires at ~3s and resets the SoC. The machine then reboots -> a
# SECOND "Booting Linux on physical CPU" in the console is the positive proof that
# the userspace-armed aspeed WDT reset the hardware (run with no --expect so the
# harness captures the whole trace incl. the reboot).
if grep -q wdtreset /proc/cmdline; then
	echo "=== WDT-RESET-TEST-BEGIN ==="
	WD=/sys/class/watchdog/watchdog0
	busybox watchdog -T 3 -t 60 /dev/watchdog 2>&1
	echo "WDT-RESET-ARMED: timeout=$(cat $WD/timeout) state=$(cat $WD/state) petinterval=60s -> expect SoC reset at ~3s"
	# Do NOT poweroff: wait for the WDT to reset the SoC. If it fires (expected) the
	# board reboots before this sleep ends and "STILL ALIVE" never prints.
	sleep 30
	echo "WDT-RESET-TEST: STILL ALIVE after 30s (UNEXPECTED -- WDT did not fire)"
	poweroff -f 2>&1 || true
fi

# --- W83795 CASEOPEN + VID validation (only when 'w83795test' on the cmdline) ---
# DEVICE-MATRIX row 16 / #183: validate the W83795G chassis-intrusion (CASEOPEN)
# + VID model additions through the Linux hwmon driver + userspace. The QEMU model
# seeds the intrusion latch =1 (ALARM(5) bit6); the mainline w83795 driver exposes
# it as /sys/class/hwmon/*/intrusion0_alarm. Writing 0 triggers the driver's
# CLR_CHASSIS[7] write, which the model handles by clearing the latch -> a re-read
# shows 0. cpu0_vid existing proves the VID_CTRL model made the driver detect VID.
if grep -q w83795test /proc/cmdline; then
	echo "=== W83795-CASEOPEN-BEGIN ==="
	# Prefer the modern-hwmon LU path (#184): the w83795 driver now exposes the
	# CASEOPEN latch as /sys/class/hwmon/*/intrusion0_alarm (read status, write 0
	# to clear via CLR_CHASSIS). This validates userspace->driver->model end to
	# end. Fall back to a raw-i2c model check if the attr isn't exposed.
	HW=""
	for d in /sys/class/hwmon/hwmon*; do
		if [ -f "$d/name" ] && grep -qi w83795 "$d/name"; then HW="$d"; break; fi
	done
	if [ -n "$HW" ] && [ -f "$HW/intrusion0_alarm" ]; then
		echo "hwmon=$HW intrusion0_alarm exposed (#184)"
		H0=$(cat "$HW/intrusion0_alarm" 2>&1)
		echo 0 > "$HW/intrusion0_alarm" 2>&1        # triggers CLR_CHASSIS in the driver
		H1=$(cat "$HW/intrusion0_alarm" 2>&1)
		echo "intrusion0_alarm: before=$H0 after 'echo 0'=$H1"
		if [ "$H0" = "1" ] && [ "$H1" = "0" ]; then
			echo "W83795-CASEOPEN RESULT: PASS (LU: hwmon intrusion0_alarm 1->0 via CLR_CHASSIS)"
		else
			echo "W83795-CASEOPEN RESULT: FAIL (hwmon before=$H0 after=$H1)"
		fi
	else
		echo "intrusion0_alarm attr NOT exposed (HW=$HW); raw-i2c model check"
		echo 1-002f > /sys/bus/i2c/drivers/w83795/unbind 2>&1 || echo "(unbind rc=$?)"
		B=1; A=0x2f
		i2cset -f -y $B $A 0x00 0x00 2>&1
		AL0=$(i2cget -f -y $B $A 0x46 2>&1)
		i2cset -f -y $B $A 0x4d 0x80 2>&1
		AL1=$(i2cget -f -y $B $A 0x46 2>&1)
		echo "ALARM(5) raw: before=$AL0 after=$AL1"
		case "$AL0" in 0x??|0x?) b0=$(( AL0 & 0x40 )) ;; *) b0=-1 ;; esac
		case "$AL1" in 0x??|0x?) b1=$(( AL1 & 0x40 )) ;; *) b1=-1 ;; esac
		if [ "$b0" -gt 0 ] && [ "$b1" = "0" ]; then
			echo "W83795-CASEOPEN RESULT: PASS (raw regs; hwmon attr not exposed)"
		else
			echo "W83795-CASEOPEN RESULT: FAIL (raw before=$AL0 after=$AL1)"
		fi
	fi
	echo "=== W83795-CASEOPEN-END ==="
	# --- Voltage/fan alarms via userspace hwmon (LU, #183) ---
	# The modern-hwmon driver now exposes inN_alarm/fanN_alarm (HWMON_I_ALARM/
	# HWMON_F_ALARM). Read a representative set through /sys/class/hwmon and assert
	# vs this board's silicon (host-w83795-sensors.txt): in0 OK=0, in1 ALARM=1,
	# in7 ALARM=1 ; fan1 OK=0, fan2 ALARM=1. hwmon names 'in' 0-based (inN=chanN)
	# and 'fan' 1-based (fanN=chan N-1). Done before the raw-i2c poke below so the
	# driver's bank state is untouched.
	echo "=== W83795-INALARM-BEGIN ==="
	if [ -n "$HW" ] && [ -f "$HW/in1_alarm" ]; then
		I0=$(cat "$HW/in0_alarm" 2>&1); I1=$(cat "$HW/in1_alarm" 2>&1)
		I7=$(cat "$HW/in7_alarm" 2>&1)
		F1=$(cat "$HW/fan1_alarm" 2>&1); F2=$(cat "$HW/fan2_alarm" 2>&1)
		echo "in0_alarm=$I0 in1_alarm=$I1 in7_alarm=$I7 fan1_alarm=$F1 fan2_alarm=$F2"
		echo "(expect in0=0 in1=1 in7=1 fan1=0 fan2=1)"
		if [ "$I0" = 0 ] && [ "$I1" = 1 ] && [ "$I7" = 1 ] && \
		   [ "$F1" = 0 ] && [ "$F2" = 1 ]; then
			echo "W83795-INALARM RESULT: PASS (LU: hwmon inN_alarm/fanN_alarm match silicon)"
		else
			echo "W83795-INALARM RESULT: FAIL (I0=$I0 I1=$I1 I7=$I7 F1=$F1 F2=$F2)"
		fi
	else
		echo "W83795-INALARM RESULT: SKIP (inN_alarm attr not exposed; HW=$HW)"
	fi
	echo "=== W83795-INALARM-END ==="
	# --- Alarm-status registers (#183) ---
	# The model now seeds ALARM(0..4) to the exact silicon state (host-side
	# lm-sensors of w83795g-i2c-14-2f, evidence/real-hw-hwpass/host-w83795-sensors.txt):
	#   in1/in3/in5/in7 out-of-range -> ALARM(0)=0x41 = 0xaa
	#   in10            out-of-range -> ALARM(1)=0x42 = 0x04
	#   in15/in16       out-of-range -> ALARM(2)=0x43 = 0x03
	#   fan2..8 = 0 RPM < min        -> ALARM(4)=0x45 = 0xfe
	# The modern-hwmon driver exposes only inN_input/fanN_input (no *_alarm attr),
	# so validate the alarm STATUS registers directly over raw i2c (force-access,
	# single-threaded init => no concurrent bank switch). Register-level proof of
	# the QEMU model seed; the userspace inN_alarm/fanN_alarm path is separate.
	echo "=== W83795-ALARM-BEGIN ==="
	B=1; A=0x2f
	i2cset -f -y $B $A 0x00 0x00 2>&1                 # select bank 0
	R41=$(i2cget -f -y $B $A 0x41 2>&1)              # ALARM(0): expect 0xaa
	R42=$(i2cget -f -y $B $A 0x42 2>&1)              # ALARM(1): expect 0x04
	R43=$(i2cget -f -y $B $A 0x43 2>&1)              # ALARM(2): expect 0x03
	R45=$(i2cget -f -y $B $A 0x45 2>&1)              # ALARM(4): expect 0xfe
	echo "ALARM(0)=$R41 ALARM(1)=$R42 ALARM(2)=$R43 ALARM(4)=$R45 (expect 0xaa 0x04 0x03 0xfe)"
	if [ "$R41" = "0xaa" ] && [ "$R42" = "0x04" ] && [ "$R43" = "0x03" ] && [ "$R45" = "0xfe" ]; then
		echo "W83795-ALARM RESULT: PASS (voltage+fan alarm status match silicon)"
	else
		echo "W83795-ALARM RESULT: FAIL (R41=$R41 R42=$R42 R43=$R43 R45=$R45)"
	fi
	echo "=== W83795-ALARM-END ==="
	poweroff -f 2>&1 || true
fi

# --- RTC counter-advance RATE validation (only when 'rtcrate' on the cmdline) ---
# DEVICE-MATRIX row 39 / #158: the AST2050 G3 RTC (0x1E781000, counter-style) has
# NO 32.768 kHz crystal on the KGPE-D16, so the firmware clocks it from the 24 MHz
# source (SCU08[16]=1); the RTC's fixed /32768 tick divider then yields
# 24e6/32768 = 732.42 "RTC seconds" per real second (datasheet §24 + silicon
# evidence d14-zephyr/14). The QEMU model now advances the counter at that rate.
# Validate register-level via /dev/mem: load 00:00:00, enable, read, sleep 1 real
# second, read again, and confirm the counter advanced ~732 (NOT ~1 as a real-time
# 1 Hz RTC would). Byte-packed counter: sec[7:0] min[15:8] hour[23:16] (see #186).
if grep -q rtcrate /proc/cmdline; then
	echo "=== RTC-RATE-BEGIN ==="
	# The RTC clock source is SCU08[16] (silicon-proven, evidence d14-zephyr/31):
	#   bit16=0 -> internal 32.768 kHz -> ÷32768 -> ~1x REAL TIME;
	#   bit16=1 -> 24 MHz "test only" tap -> ÷32768 -> ~732x (24e6/32768).
	# Validate BOTH register-level via /dev/mem (decode byte-packed sec/min/hour to
	# seconds, delta over the window = rate). This also validates that the QEMU model
	# TRACKS SCU08[16] (a fixed-732x model would fail the bit16=0 real-time leg).
	measure_rate() {   # $1 = window seconds; echoes delta (RTC-seconds)
		devmem 0x1e781014 32 0x99          # RESET
		devmem 0x1e781008 32 0x00000000    # RELOAD = 0
		devmem 0x1e781010 32 0x5a          # RESTART
		devmem 0x1e78100c 32 0x1           # enable
		C0=$(devmem 0x1e781000); sleep "$1"; C1=$(devmem 0x1e781000)
		D0=$(( (C0 & 0xff) + ((C0>>8)&0xff)*60 + ((C0>>16)&0xff)*3600 ))
		D1=$(( (C1 & 0xff) + ((C1>>8)&0xff)*60 + ((C1>>16)&0xff)*3600 ))
		echo $(( D1 - D0 ))
	}
	devmem 0x1e6e2000 32 0x1688a8a8               # unlock SCU
	S8=$(devmem 0x1e6e2008); devmem 0x1e6e2008 32 $(printf '0x%x' $(( S8 & 0xfffeffff )))  # bit16=0 (production)
	DR=$(measure_rate 3)
	echo "bit16=0 (32.768kHz source): delta=$DR over 3s  (expect ~3 = real time)"
	# IMPORTANT: bit16=1 (24MHz "test only" tap) is NOT usable under THIS (U-Boot/Linux)
	# clock config — on real AST2050 silicon it FREEZES/garbages the counter (U-Boot md/mw
	# [D] gave garbage; a runtime bit16 0->1 switch gave delta=0). The 24MHz tap only works
	# under the bare-metal Zephyr clock config (evidence d14-zephyr/14 = 732x). So we do NOT
	# test bit16=1 here: the PRODUCTION Linux RTC uses bit16=0 = REAL TIME, validated below.
	if [ "$DR" -ge 1 ] && [ "$DR" -le 9 ]; then
		echo "RTC-RATE RESULT: PASS (bit16=0 real-time ~${DR}/3s = 1x, silicon-confirmed; 24MHz tap N/A under U-Boot cfg)"
	else
		echo "RTC-RATE RESULT: FAIL (bit16=0 delta=$DR/3s, want 1-9 for real time)"
	fi
	echo "=== RTC-RATE-END ==="
	poweroff -f 2>&1 || true
fi

# --- RTC ALARM (RTC04) + alarm-interrupt (VIC 22) validation ('rtcalarm', #187) ---
# The G3 RTC can raise an interrupt when the counter matches the RTC04 alarm on the
# enabled RTC0C[1:4] fields (datasheet §24). The RTC has a SINGLE interrupt line =
# VIC source 22 and the alarm fires on it (silicon-proven #192; NOT a separate 26).
# Validate register-level via /dev/mem: load 00:00:05, set the alarm for 00:00:10
# (sec+min+hour enabled), enable; the fast counter passes 10s in ~7 ms, so the alarm
# fires and the edge latches in the VIC raw-status (0x1E6C0008 bit22=0x00400000).
# (RTC04 sec=10 fits both packings; hour/min are 0 here — the field-packed layout
# is exercised by the Zephyr/Linux hour-alarm tests.) Read it before (0) and after.
if grep -q rtcalarm /proc/cmdline; then
	echo "=== RTC-ALARM-BEGIN ==="
	# The RTC alarm delivers on the RTC's real IRQ (VIC 22), which Linux SERVICES
	# (the dts wires rtc interrupts=<22> and rtc-aspeed registered a handler). So
	# the edge does NOT sit latched in the VIC raw-status for us to read — Linux
	# claims + EOIs it. The race-free proof is therefore the Linux rtc IRQ COUNT
	# incrementing after a raw /dev/mem-programmed alarm (proving the register-level
	# alarm path reaches the real serviced VIC-22 IRQ, independent of the driver's
	# own set_alarm). Count is field 2 of the 1e781000.rtc /proc/interrupts line.
	C0=$(grep -a '1e781000.rtc' /proc/interrupts 2>&1 | awk '{print $2}')
	[ -z "$C0" ] && C0=0
	# Use bit16=0 (32.768kHz REAL TIME). The 24MHz "fast" tap is BROKEN under this
	# U-Boot/Linux clock config on silicon (freezes the counter — see the rtcrate note),
	# so it cannot be used here. The alarm PATH (RTC04 match -> VIC22) is what we validate;
	# at real time a 2-second gap (sec 1 -> 3) is crossed within our sleep.
	devmem 0x1e6e2000 32 0x1688a8a8    # unlock SCU
	S8=$(devmem 0x1e6e2008); devmem 0x1e6e2008 32 $(printf '0x%x' $(( S8 & 0xfffeffff )))  # bit16=0 real-time
	devmem 0x1e781014 32 0x99          # RESET
	devmem 0x1e781008 32 0x00000001    # RELOAD = 00:00:01 (byte-packed sec=1)
	devmem 0x1e781010 32 0x5a          # RESTART latch
	devmem 0x1e781004 32 0x00000003    # RTC04 alarm = 00:00:03 (sec=3, field-packed)
	devmem 0x1e78100c 32 0xf           # CONTROL: RTC-enable + sec+min+hour alarm
	sleep 4                            # real-time counter passes 00:00:03 within 4s
	C1=$(grep -a '1e781000.rtc' /proc/interrupts 2>&1 | awk '{print $2}')
	[ -z "$C1" ] && C1=0
	echo "rtc alarm VIC22 count: $C0 -> $C1 (/dev/mem-armed)"
	if [ "$C1" -gt "$C0" ]; then
		echo "RTC-ALARM RESULT: PASS (dev/mem RTC04 arm -> counter match -> VIC 22 IRQ serviced by Linux)"
	else
		echo "RTC-ALARM RESULT: FAIL (count $C0 -> $C1)"
	fi
	echo "=== RTC-ALARM-END ==="
	poweroff -f 2>&1 || true
fi

# --- WDT timeout-INTERRUPT mode (WDT0C[2]) validation ('wdtintr', #189) ---
# The WDT can raise an interrupt INSTEAD of resetting when it counts to zero
# (datasheet §27, WDT0C[2] wdt_intr). The model now pulses a WDT IRQ wired to VIC 27
# when the intr bit is set (reset mode is unchanged). Validate via /dev/mem: program
# WDT (base 0x1E785000) reload=10ms, CTRL = wdt_intr|1MHz|enable (0x15) to arm in
# interrupt mode; after ~10ms the WDT fires the interrupt (NOT a reset) and the edge
# latches in the VIC raw-status (0x1E6C0008 bit27=0x08000000). Read before + after.
if grep -q wdtintr /proc/cmdline; then
	echo "=== WDT-INTR-BEGIN ==="
	VICRAW=0x1e6c0008
	B4=$(devmem $VICRAW)
	devmem 0x1e785004 32 10000         # RELOAD = 10000 us = 10 ms (with 1MHz clk)
	devmem 0x1e78500c 32 0x15          # CTRL: WDT_INTR|1MHZ_CLK|ENABLE -> arm interrupt mode
	sleep 1                            # >> 10ms; WDT fires in interrupt mode (no reset)
	AF=$(devmem $VICRAW)
	echo "VIC raw before=$B4 after=$AF (WDT bit27=0x08000000)"
	b27_before=$(( B4 & 0x08000000 ))
	b27_after=$(( AF & 0x08000000 ))
	echo "IRQ27 latched: before=$b27_before after=$b27_after"
	if [ "$b27_before" = "0" ] && [ "$b27_after" -ne 0 ]; then
		echo "WDT-INTR RESULT: PASS (WDT timeout raised IRQ 27 instead of resetting the SoC)"
	else
		echo "WDT-INTR RESULT: FAIL (before=$b27_before after=$b27_after)"
	fi
	echo "=== WDT-INTR-END ==="
	poweroff -f 2>&1 || true
fi

# --- Linux RTC read check ('rtclinux'): is rtc-aspeed correct on the G3 counter-RTC? ---
# The board dts is based on aspeed-g4.dtsi -> rtc@1e781000 = aspeed,ast2400-rtc (BCD
# layout), but the REAL G3 RTC is counter-style. Read the Linux RTC and see if it is
# a sane time or garbage — resolves whether row-39 LQ "rtc-aspeed" is real or a bind-only
# over-claim.
if grep -q rtclinux /proc/cmdline; then
	echo "=== RTC-LINUX-BEGIN ==="
	ls -la /dev/rtc* 2>&1
	echo "rtc0/name = $(cat /sys/class/rtc/rtc0/name 2>&1)"
	# Read-only register snapshot: confirm the driver cleared SCU08[16] (RTC on the
	# 32.768kHz source, the silicon-proven-good state — #187 LS). No devmem writes: the
	# pure driver path is under test. (U-Boot leaves SCU08=0x61800070 / SCU0C=0x000c3e89.)
	echo "DIAG scu@linux: SCU08=$(devmem 0x1e6e2008) SCU0C=$(devmem 0x1e6e200c)"
	# Userspace set->get through the driver: set the system clock, write it to the
	# RTC (drives set_time: RELOAD+RESTART+enable), read it back (read_time). The
	# G3 RTC advances ~732x, so hour:min round-trips while sec runs ahead.
	date -s "2024-01-15 12:45:30" 2>&1
	hwclock -w 2>&1 || busybox hwclock -w 2>&1
	R=$(hwclock -r 2>&1 || busybox hwclock -r 2>&1)
	echo "hwclock -r after set 12:45:30 -> $R"
	echo "rtc0/time = $(cat /sys/class/rtc/rtc0/time 2>&1)"
	# PASS if the readback preserved the set hour (12) and minute band (advancing
	# from 45); the counter-RTC has no calendar so year/month are the fixed base.
	case "$R" in
		*" 12:4"*|*" 12:5"*) echo "RTC-LINUX RESULT: PASS (set 12:45:30 -> read $R; hour:min round-tripped via /dev/rtc0)" ;;
		*) echo "RTC-LINUX RESULT: FAIL (readback=$R)" ;;
	esac
	# --- wakealarm (#187 Linux alarm: RTC04 + VIC22 via the new driver) ---
	echo "--- wakealarm ---"
	WAKE=/sys/class/rtc/rtc0/wakealarm
	if [ -w "$WAKE" ]; then
		# RTC-alarm (VIC22) count BEFORE arming (the 1e781000.rtc line in
		# /proc/interrupts; field 2 = CPU0 count). Default 0 if not yet present.
		C0=$(grep -a '1e781000.rtc' /proc/interrupts 2>&1 | awk '{print $2}')
		[ -z "$C0" ] && C0=0
		# The RTC runs at REAL TIME (the driver clears SCU08[16]; the 24MHz fast tap is
		# broken under this U-Boot config on silicon). Arm a small +3 s alarm and wait
		# long enough for the real-time counter to reach it.
		echo 0 > "$WAKE" 2>&1              # clear any pending
		echo "+3" > "$WAKE" 2>&1           # alarm 3 seconds ahead (real time)
		SET=$(cat "$WAKE" 2>&1)
		echo "wakealarm set to (epoch)=$SET"
		sleep 6                            # real-time counter passes +3 within 6s
		AFTER=$(cat "$WAKE" 2>&1)
		C1=$(grep -a '1e781000.rtc' /proc/interrupts 2>&1 | awk '{print $2}')
		[ -z "$C1" ] && C1=0
		echo "wakealarm after sleep = '$AFTER' (empty = fired+cleared)"
		echo "rtc alarm VIC22 count: $C0 -> $C1"
		# PASS = the alarm FIRED: the VIC-22 rtc-alarm interrupt was delivered
		# (count incremented) AND the rtc core cleared the one-shot wakealarm
		# (AFTER empty). We do NOT require SET to read back non-empty: the
		# crystal-less counter runs ~732x (no 32.768kHz xtal, #158/#186), so the
		# +5 RTC-second one-shot can fire in ~7ms — before the shell reads it
		# back — leaving SET empty even on success. The IRQ-count delta is the
		# race-free arm->fire proof.
		if [ "$C1" -gt "$C0" ] && [ -z "$AFTER" ]; then
			echo "RTC-WAKEALARM RESULT: PASS (armed -> VIC22 fired ($C0->$C1) -> RTC_AF cleared it)"
		else
			echo "RTC-WAKEALARM RESULT: FAIL (set='$SET' after='$AFTER' irq=$C0->$C1)"
		fi
	else
		echo "RTC-WAKEALARM RESULT: SKIP (wakealarm attr not present)"
	fi
	echo "=== RTC-LINUX-END ==="
	poweroff -f 2>&1 || true
fi

echo "BMC-READY"   # marker the boot harness waits for
exec /bin/sh
