# SPDX-License-Identifier: Apache-2.0

if SOC_SERIES_AST2050

# Compact G3 VIC at 0x1e6c0000 has 32 sources (datasheet §16). Milestone 1's
# intc driver (vic.c) drives all 32.
configdefault NUM_IRQS
	default 32

# M1 system timer (aspeed_timer.c) uses Timer1 on the 1 MHz external timer
# clock, so the kernel cycle rate is 1 MHz.
configdefault SYS_CLOCK_HW_CYCLES_PER_SEC
	default 1000000

endif # SOC_SERIES_AST2050
