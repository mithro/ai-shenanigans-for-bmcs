CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_NS16550=y
# M0 console = the direct-physical polling backend (soc/aspeed_g3/ast2050/console.c)
# installed as the printk hook, writing UART5 @ 0x1e784000 via the static
# identity MMU region in soc.c. UART_CONSOLE is OFF so the ns16550 poll_out
# (whose CONFIG_MMU DEVICE_MMIO_MAP z_phys_map returns a VA the brand-new ARM9
# arm_mmu does not translate to 0x1e784000 -> busy-poll of an unimplemented
# address) never becomes the console.
CONFIG_UART_CONSOLE=n
CONFIG_MULTITHREADING=y

# Milestone 1 (VIC + system timer): the real G3 VIC (soc/aspeed_g3/ast2050/vic.c,
# 0x1e6c0000) and a tickful aspeed timer (aspeed_timer.c, Timer1 @ 1 MHz, VIC
# source 16) are in-tree; the VIC+timer deliver interrupts through the cortex_a_r
# isr_wrapper, and with SYS_CLOCK_EXISTS=y the kernel now runs SUSTAINED tickful
# scheduling (validated 2026-07-18 — see below).
#
# THE #141 FIX (validated). Earlier, SYS_CLOCK_EXISTS=y + default stack protection
# data-aborted at the arm_mmu L1 table (0x40008ffc) during timer-driven thread
# switching. ROOT CAUSE (OUR config, NOT an upstream bug): `l1_page_table` is a
# STATIC 16 KB-aligned var (arch/arm/core/mmu/arm_mmu.c:40) linking at ~0x40008000
# — inside the FIRST 1 MB DRAM section (0x40000000), the same section as the early
# stacks. CONFIG_HW_STACK_PROTECTION reconfigures that section on every thread
# switch, removing write access to the L1 table's own page → the next L1 write
# faults (0x40008ffc = a word in the static table). Disabling it removes the
# per-thread stack-guard MMU updates and the fault. VALIDATED by build + boot: on a
# ZEPHYR_BASE carrying PR #103557 (zephyrproject main + fetch pull/103557/head; SDK
# find lowered 1.0→0.17 for the local 0.17.0 SDK) hello_world with SYS_CLOCK_EXISTS=y
# + HW_STACK_PROTECTION=n boots "Hello World!" and runs the FULL timeout with ZERO
# data-aborts (evidence d14-zephyr/05-m1-tick-validated). So M1 (tickful scheduling)
# now works — the "upstream arm_mmu bug" framing was wrong; it was this config.
CONFIG_HW_STACK_PROTECTION=n
CONFIG_SYS_CLOCK_EXISTS=y
