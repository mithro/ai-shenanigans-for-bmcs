CONFIG_CONSOLE=y
CONFIG_SERIAL=y
# M0 console: a direct-physical polling backend (soc/aspeed/ast2050/console.c)
# installs itself as the printk hook and writes UART5 at 0x1e784000 via the
# static identity MMU region in soc.c. UART_CONSOLE is OFF so the ns16550
# poll_out (whose CONFIG_MMU DEVICE_MMIO_MAP z_phys_map returns a virtual base
# the ARM926 arm_mmu does not translate back to 0x1e784000 -> busy-poll of an
# unimplemented address, QEMU trace read @0x1e7ff014) never becomes the console
# and never hangs. ns16550 still builds/inits harmlessly for later milestones.
CONFIG_UART_NS16550=y
# Milestone 0: polling console, no system timer yet. M1 adds the aspeed timer.
CONFIG_SYS_CLOCK_EXISTS=n
CONFIG_MULTITHREADING=y
